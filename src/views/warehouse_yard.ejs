<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Freezer & containers · D' RAW</title><style>
*{box-sizing:border-box}body{font:16px system-ui;margin:0;padding:16px;color:#220b4a;background:#fff4e8}button,input,select,textarea{font:inherit;padding:12px;border-radius:10px;border:1px solid #dcd4e6}input,select,textarea{width:100%;margin:6px 0 14px}button{background:#eadcf5;color:#35116c;cursor:pointer;min-height:46px}button:disabled{opacity:.5}.primary{background:#35116c;color:white}.lime{background:#91d729}.toolbar{display:flex;gap:8px;flex-wrap:wrap}.yard{align-items:start;display:grid;grid-template-columns:repeat(auto-fit,minmax(310px,1fr));gap:18px}.container,.special{padding:16px;border:1px solid #dcd4e6;background:white;border-radius:16px;margin-bottom:16px}.lanes{display:grid;grid-template-columns:1fr 1fr;gap:12px}.slot{padding:10px;border:1px dashed #bbb0ca;border-radius:10px;margin:8px 0;overflow-wrap:anywhere}.occupied{background:#ecf6de;border-style:solid}.slot button{padding:8px;margin:4px 4px 0 0}.end{text-align:center;font-weight:700;padding:12px}small{color:#645872}h1{font-size:27px}h2{font-size:22px}#message{min-height:24px}dialog{border:0;border-radius:18px;padding:0;width:min(680px,96vw);height:94vh;max-height:94vh;background:#fff4e8;color:#220b4a}dialog::backdrop{background:#220b4a99}form{display:flex;flex-direction:column;height:100%;margin:0}.editor-body{padding:20px;overflow:auto;flex:1;min-height:0}.editor-footer{display:flex;gap:8px;flex-wrap:wrap;padding:14px;background:white;border-top:1px solid #dcd4e6}.editor-footer button{flex:1}label{display:block;font-weight:600}.line{padding:14px;background:white;border:1px solid #dcd4e6;border-radius:12px;margin:10px 0}.results button{display:block;width:100%;text-align:left;margin:5px 0}#draft-error{color:#a51e31;white-space:pre-wrap}#retry{padding:16px;background:#fff0ce;border-radius:12px;margin:12px 0}@media(max-width:400px){body{padding:10px}.yard{grid-template-columns:1fr}.lanes{gap:6px}.slot{padding:7px}}
.layout-search{display:flex;align-items:center;gap:8px;margin-top:12px}.layout-search input{flex:1;min-width:0;margin:0}.layout-search button{flex:0 0 auto;font-size:14px}
[hidden]{display:none!important}
.destination-containers{display:flex;flex-wrap:wrap;gap:7px}.destination-containers button{padding:10px}.destination-lanes{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:12px 0}.destination-slot{display:block;width:100%;padding:12px 6px;margin:8px 0;min-height:66px;background:#f5f0fb;text-align:left}.destination-slot small{display:block;font-size:11px;line-height:1.3}.destination-slot.occupied{background:#e4eadf}.destination-slot.selected{outline:3px solid #ed168b;background:#dff4b4}.visual-locations{padding:12px;border:1px solid #dcd4e6;border-radius:14px;margin:12px 0}.container-focus{max-width:450px;margin:14px 0}.container>summary{cursor:pointer;font-weight:750;font-size:22px;padding:8px 0}.container>summary small{display:block;font-size:14px;font-weight:400;margin:5px 0 0 22px}.container>summary:focus-visible{outline:3px solid #ed168b;outline-offset:4px}.container-body{padding-top:10px}.container-controls{margin:12px 0}</style><link rel="stylesheet" href="/warehouse-ui.css"><link rel="stylesheet" href="/workspaces-assets/walkin-map.css"></head><body><h1>Freezer & container layout</h1><p>Scan or search a product, build a full or mixed pallet, then choose where it goes.</p><div class="toolbar"><a href="/warehouse-reconciliation" class="primary" style="padding:12px;border-radius:10px;text-decoration:none">Inventory reconciliation</a><button id="register" class="primary">Register pallet</button><button id="refresh">Refresh layout</button></div><div class="layout-search"><input id="search" aria-label="Search layout" enterkeyhint="done" placeholder="Find product, lot or slot"><button type="button" id="hide-search-keyboard">Hide keyboard</button></div><p id="message" role="status"></p><div id="retry" hidden><p>A stock save is waiting for confirmation. Retry the same save to avoid a duplicate.</p><button id="retry-save" class="primary">Retry save</button> <button id="discard-save">Discard pending request</button></div><div class="container-focus"><label for="container-focus">I am working in</label><select id="container-focus"><option value="all">All storage locations</option><option value="WALKIN">Walk-in freezer</option><option value="RETURNS">Returns / staging</option></select></div><div id="walkin-map"></div><div id="specials"></div><div class="toolbar container-controls"><button type="button" id="collapse-containers">Collapse all containers</button><button type="button" id="expand-containers">Expand all containers</button></div><div id="yard" class="yard"></div>
<dialog id="editor"><form id="form"><div class="editor-body"><h2 id="editor-title"></h2><p id="editor-help"></p><label for="location">Storage location</label><select id="location" required></select><div id="destination-picker"></div><section id="product-tools"><label for="productSearch">Scan barcode or search product / SKU</label><input id="productSearch" autocomplete="off" placeholder="Scan, type or paste"><small id="catalog-status"></small><div id="results" class="results"></div></section><div id="lines"></div><label id="notes-label" for="notes">Pallet notes</label><textarea id="notes" maxlength="1000"></textarea><div id="reason-wrap"><label for="reason">Reason for correction</label><textarea id="reason" maxlength="1000" placeholder="Explain the stock correction"></textarea></div><p id="draft-error" role="alert"></p></div><div class="editor-footer"><button type="submit" class="primary" id="save">Save pallet</button><button type="button" id="cancel">Cancel</button><button type="button" id="keyboard">Hide keyboard</button></div></form></dialog>
<script type="module">
import {stockLocationPicker} from '/workspaces-assets/stock-location-picker.js';
import {palletSVG} from "/workspaces-assets/pallet-visual.js";
import {renderWalkinMap} from '/workspaces-assets/walkin-map.js';
import {walkinPositions} from '/workspaces-assets/walkin-layout.js';
import {drawStockVolume} from '/workspaces-assets/pallet-volume.js';
const $=id=>document.getElementById(id);let data,catalog,session,draft,pending,busy=false,storeKey,locationPicker;
let collapsedContainers={};try{collapsedContainers=JSON.parse(localStorage.getItem('warehouse-collapsed-containers')||'{}')||{};}catch{}
function rememberContainers(){try{localStorage.setItem('warehouse-collapsed-containers',JSON.stringify(collapsedContainers));}catch{}}
function node(tag,text){const n=document.createElement(tag);if(text!==undefined)n.textContent=text;return n;}
function button(text,fn,kind=''){const b=node('button',text);b.type='button';b.className=kind;b.onclick=fn;return b;}
async function api(path,body){const r=await fetch('/api/warehouse'+path,{credentials:'same-origin',headers:body?{'Content-Type':'application/json','X-Warehouse-CSRF':session.csrf}:{},...(body?{method:'POST',body:JSON.stringify(body)}:{})});const d=await r.json();if(!r.ok)throw Error(d.error||'Unable to complete request.');return d;}
function items(p){return p.items||[p];}function stock(parent,p){for(const i of items(p)){const row=node('div');row.append(node('div',i.sku_name||i.name||'Product'),node('small',[i.qty_units+' '+(i.unit_type||'units'),i.lot_number?'Lot '+i.lot_number:'',i.notes||''].filter(Boolean).join(' · ')));parent.append(row);}const volume=node('details');volume.append(node('summary','Pallet layers / volume'));volume.ontoggle=()=>{if(volume.open&&!volume.dataset.drawn){volume.dataset.drawn='1';for(const i of items(p)){volume.append(node('p',i.sku_name||i.name));const art=node('div');art.style='height:240px;max-width:100%';drawStockVolume(art,i);volume.append(art);}}};parent.append(volume);parent.append(button('Move',()=>open('move',p)),button('Edit / mix',()=>open('edit',p)),button('Copy pallet',()=>open('copy',p)));}
function special(title,ps){const box=node('section');box.className='special';box.append(node('h2',title));for(const p of ps){const c=node('div');c.className='slot occupied';const art=node('div');art.innerHTML=palletSVG(p);c.append(art);stock(c,p);box.append(c);}if(!ps.length)box.append(node('p','No stock recorded'));$('specials').append(box);}
function draw(){if(!data)return;const focus=$('container-focus').value;$('walkin-map').hidden=!['all','WALKIN'].includes(focus);$('yard').replaceChildren();$('specials').replaceChildren();renderWalkinMap($('walkin-map'),[...(data.walkin||[]),...(data.loose||[]).map(p=>({...p,loose:true}))],{onMove:p=>open('move',p),onEdit:p=>open('edit',p),onAdd:code=>open('new',null,code),onCopy:p=>open('copy',p)});if(['all','RETURNS'].includes(focus))special('Returns / staging',data.returns||[]);for(const c of data.yard){if(focus!=='all'&&focus!==String(c.containerNo))continue;const section=node('details');section.className='container';section.dataset.container=c.containerNo;section.open=!collapsedContainers[c.containerNo];const heading=node('summary','Container '+c.containerNo),slots=[...c.left,...c.right],occupied=slots.filter(s=>s.pallet).length;heading.append(node('small',occupied+' of '+slots.length+' positions occupied'+((c.unmappedPallets||[]).length?' · '+c.unmappedPallets.length+' unpositioned pallets':'')));const body=node('div');body.className='container-body';section.append(heading,body);section.ontoggle=()=>{if($('search').value.trim())return;collapsedContainers[c.containerNo]=!section.open;rememberContainers();};if(['admin','manager','office'].includes(session?.user.role))body.append(button('Change pallet layout',()=>layoutSettings(c)));const back=node('div','BACK / CLOSED END');back.className='end';body.append(back);const lanes=node('div');lanes.className='lanes';for(const [name,slots] of [['LEFT',c.left],['RIGHT',c.right]]){const lane=node('div');const orientation=(name==='LEFT'?c.layout?.leftOrientation:c.layout?.rightOrientation)||'straight';lane.append(node('h3',name+' · '+slots.length+' '+orientation),node('small',orientation==='sideways'?'48 inches across · 40 inches along':'40 inches across · 48 inches along'));for(const s of [...slots].reverse()){const box=node('div');box.className='slot'+(s.pallet?' occupied':'');const footprint=node('div');footprint.innerHTML=palletSVG(s.pallet,orientation);footprint.style='margin-bottom:8px;max-width:100%';box.append(footprint,node('b',s.code||name+' '+s.depth));if(s.pallet)stock(box,s.pallet);else box.append(node('p','Empty'),button('Add here',()=>open('new',null,s.code)));lane.append(box);}lanes.append(lane);}body.append(lanes);const door=node('div','DOOR / ENTRANCE');door.className='end';body.append(door);for(const p of c.unmappedPallets||[])stock(body,p);$('yard').append(section);}filter();}
function layoutSettings(c){if(pending||busy){$('message').textContent='Finish the pending stock save first.';return;}const dialog=node('dialog'),form=node('form'),body=node('div');body.className='editor-body';body.append(node('h2','Container '+c.containerNo+' · pallet layout'),node('p','All pallets are 40 × 48 inches. Position 01 stays nearest the door. Existing stock keeps its current position.'));const mode=node('select'),flip=node('select'),small=c.containerNo===1;mode.append(new Option(small?'8 pallets · 4 straight on each side':'18 pallets · 9 straight on each side',small?'8-slot':'18-slot'),new Option(small?'9 pallets · 5 sideways + 4 straight':'20 pallets · 11 sideways + 9 straight',small?'9-slot':'20-slot'));mode.value=c.layout.mode;flip.append(new Option(small?'LEFT: 5 sideways · RIGHT: 4 straight':'LEFT: 11 sideways · RIGHT: 9 straight','L_LONG'),new Option(small?'LEFT: 4 straight · RIGHT: 5 sideways':'LEFT: 9 straight · RIGHT: 11 sideways','R_LONG'));flip.value=c.layout.flip;body.append(node('label','Capacity'),mode,node('label','Sideways row'),flip);mode.onchange=()=>flip.disabled=mode.value===(small?'8-slot':'18-slot');mode.onchange();const footer=node('div');footer.className='editor-footer';const save=node('button','Save layout');save.type='submit';save.className='primary';footer.append(save,button('Cancel',()=>dialog.close()));form.append(body,footer);dialog.append(form);document.body.append(dialog);dialog.onclose=()=>dialog.remove();let request;form.onsubmit=async e=>{e.preventDefault();save.disabled=true;try{request??={requestId:crypto.randomUUID(),containerNo:c.containerNo,expectedMode:c.layout.mode,expectedFlip:c.layout.flip,mode:mode.value,flip:flip.value};await api('/container-layout/settings',request);dialog.close();await load();$('message').textContent='Pallet layout saved and audited. No stock was moved.';}catch(error){$('message').textContent=error.message;body.append(node('p',error.message));}finally{save.disabled=false;}};dialog.showModal();}
function filter(){const q=$('search').value.toLowerCase().trim();for(const s of document.querySelectorAll('.slot'))s.hidden=!!q&&!s.textContent.toLowerCase().includes(q);for(const c of document.querySelectorAll('#yard>.container')){c.hidden=!!q&&![...c.querySelectorAll('.slot')].some(s=>!s.hidden);c.open=q?!c.hidden:!collapsedContainers[c.dataset.container];}}
function expandContainers(expanded){$('search').value='';for(const c of data?.yard||[])collapsedContainers[c.containerNo]=!expanded;rememberContainers();filter();}
$('collapse-containers').onclick=()=>expandContainers(false);$('expand-containers').onclick=()=>expandContainers(true);
function locations(){return ['WALKIN',...(draft?.mode==='copy'?[]:['RETURNS']),...(data?.yard||[]).flatMap(c=>[...c.left,...c.right].filter(s=>!s.pallet).map(s=>s.code))];}
async function open(mode,p=null,position=''){if(busy||pending){$('message').textContent='Resolve the pending save before starting another.';return;}if(!catalog){$('message').textContent='Loading warehouse products…';try{catalog=await api('/stock/catalog');}catch(e){$('message').textContent=e.message;return;}}
 draft={mode,p,lines:p?items(p).map(i=>({id:i.id,skuId:i.sku_id,qty:i.qty_units,expectedNotes:i.notes||'',notes:i.notes||'',name:i.sku_name||i.name,unit:i.unit_type})):[]};$('editor-title').textContent=mode==='copy'?'Copy pallet as new inventory':mode==='new'?(position==='WALKIN'?'Add products to walk-in freezer':'Register a pallet'):mode==='move'?'Move whole pallet':'Edit pallet / add mixed products';$('editor-help').textContent=mode==='copy'?'This creates additional stock. The source pallet stays unchanged. For a mixed pallet, every product line is copied with its quantity.':mode==='move'?'All products on this physical pallet move together.':'Scanning selects a product. Stock changes only when you press Save pallet. Quantities use the displayed warehouse unit.';
 $('location').replaceChildren(new Option('Choose storage location',''));for(const code of locations())$('location').add(new Option(code==='WALKIN'?'Walk-in freezer · general storage':code==='RETURNS'?'Returns / staging':walkinPositions.find(p=>p.code===code)?.label||code,code));if(mode==='edit')$('location').replaceChildren(new Option('Current position — unchanged','current'));$('location').value=mode==='edit'?'current':position;$('location').disabled=mode==='edit';$('save').textContent=position==='WALKIN'?'Save walk-in stock':'Save stock';$('product-tools').hidden=mode==='move'||mode==='copy';$('reason-wrap').hidden=mode!=='edit';$('notes-label').hidden=$('notes').hidden=!['new','copy'].includes(mode);$('notes').value='';$('reason').value='';$('reason').required=false;$('reason').minLength=0;$('reason-wrap').hidden=true;$('reason').placeholder='Required only if an existing quantity or note changes';$('productSearch').value='';$('results').replaceChildren();$('draft-error').textContent='';$('catalog-status').textContent=catalog.warning||catalog.barcodeStatus||'';renderLines();$('location').hidden=mode!=='edit';$('location').required=false;$('destination-picker').hidden=mode==='edit';if(mode!=='edit')locationPicker=stockLocationPicker($('destination-picker'),{yard:data.yard,allowed:locations(),selected:position,initialContainer:$('container-focus').value==='all'?(p?.location_code||'').match(/^C(\d+)-/)?.[1]:$('container-focus').value,onSelect:code=>{$('location').value=code;}});$('editor').showModal();}
function addProduct(p){const old=draft.lines.find(l=>l.skuId===p.id);if(old){document.querySelector('[data-sku="'+p.id+'"] input')?.focus();return;}draft.lines.push({skuId:p.id,qty:1,name:p.name,unit:p.unit_type,lotId:null,configId:null});$('productSearch').value='';$('results').replaceChildren();renderLines();document.querySelector('[data-sku="'+p.id+'"] input')?.focus();}
function correctionReason(){const changed=draft?.mode==='edit'&&draft.lines.some(l=>{if(!l.id)return false;const old=items(draft.p).find(i=>i.id===l.id);return Number(l.qty)!==Number(old.qty_units)||String(l.notes||'')!==String(old.notes||'');});$('reason-wrap').hidden=!changed;$('reason').required=!!changed;$('reason').minLength=changed?5:0;}
function renderLines(){correctionReason();$('lines').replaceChildren();if(draft.mode==='copy'){for(const l of draft.lines){const label=node('label',l.name+' · '+(l.unit||'units')),qty=node('input');qty.type='number';qty.min='0.000001';qty.step='any';qty.required=true;qty.value=l.qty;qty.disabled=draft.lines.length>1;qty.oninput=()=>l.qty=Number(qty.value);label.append(qty);$('lines').append(label);}return;}if(draft.mode==='move'){for(const i of draft.lines)$('lines').append(node('p',i.name+' · '+i.qty+' '+(i.unit||'units')));return;}for(const l of draft.lines){const box=node('div');box.className='line';box.dataset.sku=l.skuId;box.append(node('b',l.name));const label=node('label','Quantity · '+(l.unit||'units')),qty=node('input');qty.type='number';qty.min=l.id?'0':'0.000001';qty.step='any';qty.required=true;qty.value=l.qty;qty.oninput=()=>{l.qty=Number(qty.value);correctionReason();};label.append(qty);box.append(label);if(!l.id){for(const c of (catalog.palletConfigs||[]).filter(c=>c.sku_id===l.skuId))box.append(button('Full pallet · '+c.units_per_pallet+' '+(l.unit||'units'),()=>{l.qty=c.units_per_pallet;l.configId=c.id;renderLines();},'lime'));const lots=(catalog.lots||[]).filter(x=>x.sku_id===l.skuId);if(lots.length){const lab=node('label','Lot'),select=node('select');select.add(new Option('No lot selected',''));for(const lot of lots)select.add(new Option(lot.lot_number,lot.id));select.value=l.lotId||'';select.onchange=()=>l.lotId=select.value?Number(select.value):null;lab.append(select);box.append(lab);}box.append(button('Remove from draft',()=>{draft.lines=draft.lines.filter(x=>x!==l);renderLines();}));}else{box.append(node('small','Set quantity to 0 to remove this stock.'));const lab=node('label','Product notes'),input=node('textarea');input.maxLength=1000;input.value=l.notes;input.oninput=()=>{l.notes=input.value;correctionReason();};lab.append(input);box.append(lab);}$('lines').append(box);}}
const norm=s=>String(s||'').trim().toUpperCase();function matches(q){return catalog.products.filter(p=>norm(p.qbo_sku)===q||(p.barcodes||[]).some(b=>norm(b)===q));}
function search(){if(!draft||draft.mode==='move')return;const q=norm($('productSearch').value);$('results').replaceChildren();if(!q)return;const found=catalog.products.filter(p=>norm(p.name).includes(q)||norm(p.qbo_sku).includes(q)||(p.barcodes||[]).some(b=>norm(b).includes(q)));for(const p of found.slice(0,25))$('results').append(button(p.name+' · '+(p.qbo_sku||'')+' · '+(p.unit_type||'units'),()=>addProduct(p)));if(!found.length)$('results').append(node('p','No matching warehouse product. Try its name or SKU.'));}
function scan(value){if(!$('editor').open)return;const q=norm(value),loc=locations().find(x=>norm(x)===q);if(loc&&draft.mode!=='edit'){$('location').value=loc;locationPicker?.select(loc);return;}if(draft.mode==='move')return;$('productSearch').value=value;const found=matches(q);if(found.length===1)addProduct(found[0]);else{search();$('draft-error').textContent=found.length>1?'This code matches more than one product. Choose the correct item.':'Barcode not recognized. Search and choose the product.';}}
function pendingUI(){$('retry').hidden=!pending;$('save').disabled=!!pending||busy;}
async function submitPending(){if(!pending||busy)return;busy=true;pendingUI();try{const result=await api(pending.path,pending.body);localStorage.removeItem(storeKey);pending=null;$('editor').close();$('message').textContent=result.message||'Stock saved.';await load(false);}catch(e){$('message').textContent=$('draft-error').textContent=e.message+' Your save is retained for retry.';}finally{busy=false;pendingUI();}}
$('form').onsubmit=async e=>{e.preventDefault();if(busy||pending)return;$('draft-error').textContent='';if(draft.mode!=='move'&&!draft.lines.length){$('draft-error').textContent='Add at least one product.';return;}if(draft.mode!=='edit'&&!locations().includes($('location').value)){$('draft-error').textContent='Choose a destination on the container map.';return;}const mode=draft.mode,body={requestId:crypto.randomUUID(),locationCode:$('location').value,notes:$('notes').value,reason:$('reason').value};if(mode!=='new'){body.expectedItems=draft.p.copy_fingerprint;body.palletId=draft.p.id;}if(mode==='copy')body.qty=draft.lines[0]?.qty;if(mode!=='move'&&mode!=='copy')body.items=draft.lines.map(l=>({...(l.id?{id:l.id,expectedNotes:l.expectedNotes,notes:l.notes}:{}),skuId:l.skuId,qty:l.qty,lotId:l.lotId||null,configId:l.configId||null}));pending={path:mode==='new'?'/stock/pallets':'/stock/pallets/'+draft.p.id+'/'+mode,body};try{localStorage.setItem(storeKey,JSON.stringify(pending));}catch{pending=null;$('draft-error').textContent='Unable to retain a safe retry. Free device storage and try again.';return;}await submitPending();};
$('productSearch').oninput=search;$('productSearch').onkeydown=e=>{if(e.key==='Enter'){e.preventDefault();scan(e.target.value);}};window.addEventListener('zebra-scan',e=>scan(e.detail?.barcode||e.detail?.code||e.detail));function hideKeyboard(){document.querySelectorAll('input,textarea,select').forEach(e=>e.blur());}$('keyboard').onclick=hideKeyboard;$('hide-search-keyboard').onclick=hideKeyboard;$('search').onkeydown=e=>{if(e.key==='Enter'){e.preventDefault();hideKeyboard();}};$('cancel').onclick=()=>$('editor').close();$('editor').addEventListener('cancel',e=>{if(busy)e.preventDefault();});$('retry-save').onclick=submitPending;$('discard-save').onclick=()=>{if(confirm('The server may already have applied this save. Refresh and review the stock before trying again. Discard the pending request?')){pending=null;localStorage.removeItem(storeKey);pendingUI();$('editor').close();load();}};$('register').onclick=()=>open('new');$('refresh').onclick=()=>{catalog=null;load();};$('search').oninput=filter;$('container-focus').onchange=()=>{localStorage.setItem('warehouse-container-focus', $('container-focus').value);draw();};
async function load(notify=true){try{data=await api('/container-layout');const select=$('container-focus'),previous=select.value;select.replaceChildren(new Option('All storage locations','all'),new Option('Walk-in freezer','WALKIN'),new Option('Returns / staging','RETURNS'),...data.yard.map(c=>new Option('Container '+c.containerNo,String(c.containerNo))));select.value=[...select.options].some(o=>o.value===previous)?previous:'all';draw();if(notify)$('message').textContent='Updated '+new Date().toLocaleTimeString();}catch(e){$('message').textContent=e.message;}}
(async()=>{try{session=await api('/session');storeKey='warehouse-pallet-save:'+session.user.id;try{pending=JSON.parse(localStorage.getItem(storeKey)||'null');}catch{pending=null;}pendingUI();await load();const savedFocus=localStorage.getItem('warehouse-container-focus');if(savedFocus&&[...$('container-focus').options].some(o=>o.value===savedFocus)){$('container-focus').value=savedFocus;draw();}const requested=new URLSearchParams(location.search).get('addWalkin');if(requested==='WALKIN'||walkinPositions.some(p=>p.code===requested))await open('new',null,requested);}catch(e){$('message').textContent=e.message;}})();
</script><script type="module" src="/workspaces-assets/yard-temperatures.js"></script><script type="module" src="/workspaces-assets/office-notification.js"></script></body></html>
