<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Container layout</title><style>*{box-sizing:border-box}body{font:16px system-ui;padding:16px;margin:0;color:#193d31;background:#f4f7f3}button,input{font:inherit;padding:12px;border-radius:8px;border:1px solid #bdcfc2}input{width:100%;margin:12px 0}.yard{display:grid;grid-template-columns:repeat(auto-fit,minmax(310px,1fr));gap:18px}.container,.special{padding:16px;border:1px solid #ccdacf;background:white;border-radius:12px;margin-bottom:16px}.lanes{display:grid;grid-template-columns:1fr 1fr;gap:12px}.slot{padding:10px;border:1px dashed #b8cbbf;border-radius:7px;margin:8px 0;overflow-wrap:anywhere}.occupied{background:#e3efdf;border-style:solid}.end{text-align:center;font-weight:700;padding:12px}.product{font-weight:600}small{color:#586d61}h1{font-size:27px}h2{font-size:22px}</style></head><body><h1>Freezer & container layout</h1><p>Current saved layout and stock. View access for warehouse and management.</p><button id="refresh">Refresh layout</button><input id="search" placeholder="Find product, lot or slot"><p id="message" role="status"></p><div id="specials"></div><div id="yard" class="yard"></div><script>
const $=id=>document.getElementById(id);let data;function node(tag,text){const n=document.createElement(tag);if(text!==undefined)n.textContent=text;return n;}
function stock(parent,p){for(const i of p.items||[p]){parent.append(node('div',i.sku_name||i.name||'Product'));const text=[i.qty_units+' '+(i.unit_type||'cases'),i.lot_number?'Lot '+i.lot_number:'',i.notes||''].filter(Boolean).join(' · ');parent.append(node('small',text));}}
function special(title,items){const box=node('section');box.className='special';box.append(node('h2',title));for(const p of items){const c=node('div');c.className='slot occupied';stock(c,p);box.append(c);}if(!items.length)box.append(node('p','No stock recorded'));$('specials').append(box);}
function draw(){if(!data)return;$('yard').replaceChildren();$('specials').replaceChildren();special('Walk-in freezer',data.walkin||[]);special('Walk-in loose stock',data.loose||[]);special('Returns / staging',data.returns||[]);for(const c of data.yard){const section=node('section');section.className='container';section.append(node('h2','Container '+c.containerNo),node('p',c.layout?.label||''));const back=node('div','BACK / CLOSED END');back.className='end';section.append(back);const lanes=node('div');lanes.className='lanes';for(const [name,slots] of [['LEFT',c.left],['RIGHT',c.right]]){const lane=node('div');lane.append(node('h3',name));for(const s of [...slots].reverse()){const box=node('div');box.className='slot'+(s.pallet?' occupied':'');box.append(node('b',s.code||name+' '+s.depth));if(s.pallet)stock(box,s.pallet);else box.append(node('p','Empty'));lane.append(box);}lanes.append(lane);}section.append(lanes);const door=node('div','DOOR / ENTRANCE');door.className='end';section.append(door);if(c.unmappedPallets?.length){section.append(node('h3','Location review needed'));for(const p of c.unmappedPallets)stock(section,p);}$('yard').append(section);}filter();}
function filter(){const q=$('search').value.toLowerCase().trim();for(const s of document.querySelectorAll('.slot'))s.hidden=!!q&&!s.textContent.toLowerCase().includes(q);}
async function load(){try{const r=await fetch('/api/warehouse/container-layout',{credentials:'same-origin'}),d=await r.json();if(!r.ok)throw Error(d.error);data=d;draw();$('message').textContent='Updated '+new Date().toLocaleTimeString();}catch(e){$('message').textContent=e.message;}}$('refresh').onclick=load;$('search').oninput=filter;load();
</script></body></html>
