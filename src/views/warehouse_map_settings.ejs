<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/warehouse-ui.css"><title>Map settings · D’ RAW</title></head><body><main><h1>Satellite & driving routes</h1><p>Administrator setup. Uses Google Maps Platform; a Gmail account alone does not enable the APIs.</p><p>Enable Maps JavaScript API and Routes API in your Google Cloud project. Use a browser key restricted to this app’s website for Maps JavaScript API, and a separate server key restricted to Routes API.</p><p><a href="https://console.cloud.google.com/google/maps-apis/overview" target="_blank" rel="noopener">Open Google Maps Platform setup</a></p><form id="settings"><label>Browser map key<input id="browser-key" type="password" autocomplete="off" placeholder="Leave blank to keep the configured key"></label><label>Server routing key<input id="routes-key" type="password" autocomplete="off" placeholder="Leave blank to keep the configured key"></label><label><input type="checkbox" id="enabled">Enable satellite imagery and road routing</label><label><input type="checkbox" id="consent">Allow Google to receive viewed map areas and stop coordinates to load imagery and calculate driving routes. Names, invoices, product details and notes are not included in routing requests.</label><p>Driving estimates follow your saved stop order. They are not turn-by-turn navigation, truck-clearance checks, or live traffic estimates. Setup may require Google billing; saving this form does not create a Google account or change billing.</p><button class="primary">Save map settings</button></form><p id="status" role="status"></p></main><script>
const $=id=>document.getElementById(id);let session;async function api(body){const r=await fetch('/api/warehouse/map-settings',{credentials:'same-origin',cache:'no-store',...(body?{method:'POST',headers:{'Content-Type':'application/json','X-Warehouse-CSRF':session.csrf},body:JSON.stringify(body)}:{})});const d=await r.json();if(!r.ok)throw Error(d.error||'Map settings unavailable');return d;}function show(d){$('enabled').checked=d.ready;$('status').textContent=d.ready?'Google satellite and road routing connected.':d.browserKeyConfigured||d.routesKeyConfigured?'Setup incomplete. Review both keys and enabled APIs.':'Google Maps API setup is still needed.';}fetch('/api/warehouse/session',{credentials:'same-origin'}).then(r=>r.json()).then(async d=>{session=d;show(await api());}).catch(e=>$('status').textContent=e.message);$('settings').onsubmit=async e=>{e.preventDefault();try{show(await api({browserKey:$('browser-key').value,routesKey:$('routes-key').value,enabled:$('enabled').checked,providerConsent:$('consent').checked}));$('browser-key').value=$('routes-key').value='';}catch(error){$('status').textContent=error.message;}};
</script></body></html>
