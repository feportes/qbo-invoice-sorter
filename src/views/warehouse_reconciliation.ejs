<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Inventory reconciliation · D’ RAW</title><link rel="stylesheet" href="/warehouse-ui.css"><style>
*{box-sizing:border-box}body{margin:0;padding:20px;background:#fff4e8;color:#220b4a;font:16px system-ui}main{max-width:1500px;margin:auto}button,input,select,textarea{font:inherit;border:1px solid #dcd4e6;border-radius:12px;padding:12px;max-width:100%}button{background:#eadcf5;color:#35116c;cursor:pointer;min-height:46px}button.primary{background:#35116c;color:white}button:disabled{opacity:.5}a{color:#35116c}.toolbar{display:flex;gap:10px;flex-wrap:wrap;margin:15px 0;align-items:center}.card{background:white;padding:18px;border:1px solid #dcd4e6;border-radius:16px;margin:14px 0}.stats{font-weight:bold;background:#eae1f5;padding:14px;border-radius:12px}.warning{background:#fff0c9;padding:12px;border-radius:10px}.variance{background:#fff0cf}.matched{color:#17633a}input[type=search]{width:min(600px,100%)}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:13px 9px;border-bottom:1px solid #e3d9f0}td input{width:110px}td textarea{width:220px;min-height:48px}small{display:block;color:#67577b}.reports{display:flex;gap:8px;flex-wrap:wrap}[hidden]{display:none!important}#message{white-space:pre-wrap}label{display:block;margin:10px 0}dialog{border:0;border-radius:16px;width:min(600px,95vw)}dialog input,dialog select{width:100%}@media(max-width:700px){thead{display:none}tr{display:block;margin:12px 0;padding:12px;border:1px solid #dcd4e6;border-radius:12px;background:white}td{display:block;padding:5px;border:0}td[data-label]:before{content:attr(data-label) ': ';font-weight:600}td input,td textarea{width:100%}}@media print{body{background:white;padding:0;font-size:10px}.no-print,#message,#report-list{display:none!important}table{display:table}thead{display:table-header-group}tr{display:table-row;break-inside:avoid}td,th{display:table-cell;padding:5px;border:1px solid #ddd}input,textarea{border:0!important;padding:0!important}textarea{height:auto}.card{border:0;padding:0}}
</style></head><body><main><a class="no-print" href="/warehouse-yard">← Freezer & containers</a><h1>Inventory reconciliation</h1><p>Compare a physical count with QuickBooks. Submit it for office review.</p><p id="message" role="status"></p><div class="toolbar no-print"><button id="new-count" class="primary">Start inventory count</button><button id="refresh">Refresh reports</button></div><section id="report-list" class="card"><h2>Count reports</h2><div id="reports" class="reports"></div></section><section id="report" hidden><div id="heading"></div><div class="toolbar no-print"><input id="search" type="search" autocomplete="off" placeholder="Scan barcode or search product / SKU"><button id="hide-keyboard">Hide keyboard</button><label><input id="counted-only" type="checkbox"> Counted products only</label></div><div class="toolbar no-print"><button id="save" class="primary">Save counts</button><button id="submit" class="primary">Submit for office review</button><button id="csv">Download CSV</button><button id="print">Print report</button><button id="review" hidden>Mark reviewed</button><button id="retry" hidden>Retry the same save</button></div><p id="scope-warning" class="warning"></p><p id="stats" class="stats"></p><table><thead><tr><th>Product</th><th>QuickBooks on hand</th><th>Mapped stock</th><th>Employee count</th><th>Difference</th><th>Employee notes</th></tr></thead><tbody id="rows"></tbody></table><p id="showing"></p><p id="review-note"></p></section><dialog id="create"><form id="create-form"><h2>Start a count</h2><label>Report name<input id="title" maxlength="150" required></label><label>Count covers<select id="scope"><option value="warehouse">Entire warehouse inventory</option><option value="containers">Containers only</option></select></label><p>A fresh QuickBooks snapshot will be saved with this report. Blank physical counts remain uncounted; enter 0 only after confirming there is none.</p><button type="submit" class="primary">Create report</button> <button type="button" id="cancel">Cancel</button></form></dialog></main><script type="module" src="/workspaces-assets/inventory-reconciliation.js"></script><script type="module" src="/workspaces-assets/dialog-dismiss.js"></script><script type="module" src="/workspaces-assets/office-notification.js"></script></body></html>
