<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Security · D' RAW</title><link rel="stylesheet" href="/warehouse-ui.css"></head><body><main><a href="/warehouse">← Management</a><p class="eyebrow">D’ RAW · SECURITY</p><h1>Auto sign-out</h1><p>Admin and management accounts sign out after this period without interaction. Driver accounts keep working on their routes.</p><section class="card"><form id="policy"><label>Office inactivity limit · minutes<input id="minutes" type="number" min="1" max="120" value="5" required></label><p>Applies to admin, manager and office roles on the Android and Safari apps. Devices receive the latest setting when connected. Saved route work, drafts and photos remain on the device.</p><button class="primary">Save timeout</button></form></section><p id="message" role="status"></p></main><script>
let csrf;const message=document.getElementById('message');async function load(){const r=await fetch('/api/warehouse/session'),s=await r.json();if(!r.ok||s.user.role!=='admin'){document.getElementById('policy').hidden=true;message.textContent='Administrator access is required to change security settings.';return;}csrf=s.csrf;const p=await(await fetch('/api/warehouse/session-policy')).json();document.getElementById('minutes').value=p.officeIdleMinutes;}document.getElementById('policy').onsubmit=async e=>{e.preventDefault();const r=await fetch('/api/warehouse/session-policy',{method:'POST',headers:{'Content-Type':'application/json','X-Warehouse-CSRF':csrf},body:JSON.stringify({officeIdleMinutes:Number(document.getElementById('minutes').value)})});const d=await r.json();message.textContent=r.ok?'Timeout saved and audited. Connected devices will pick it up automatically.':d.error;};load().catch(()=>message.textContent='Connect and refresh to manage security.');
</script><script type="module" src="/workspaces-assets/office-notification.js"></script></body></html>
