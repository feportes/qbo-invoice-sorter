<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Warehouse picking</title><style>
*{box-sizing:border-box}body{font:17px system-ui;margin:0;padding:18px;background:#f4f7f3;color:#193d31}h1{font-size:27px}button,input,select{font:inherit;min-height:48px;padding:10px;border:1px solid #b9cbbf;border-radius:8px;max-width:100%}button{background:#235c47;color:white;cursor:pointer}button:disabled{opacity:.5}.row{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}.card{background:white;border:1px solid #d6e1d7;border-radius:12px;padding:16px;margin:14px 0}.warning{background:#fff0ec;padding:12px;border-radius:8px}.ok{background:#e1efdf}label{display:block;margin:12px 0}input:not([type=checkbox]),select{width:100%}.count{font-size:34px;font-weight:700;color:#a72e28}.primary{width:100%;font-weight:700}small{color:#5b7164}#message{white-space:pre-line}progress{width:100%;height:18px}summary{padding:12px;cursor:pointer}

/* D RAW website palette; operational status colors remain explicit. */
:root{--draw-cream:#fff4e8;--draw-deep:#220b4a;--draw-green:#91d729;--draw-pink:#ed168b;--draw-purple:#35116c;--draw-line:#dcd4e6;background:var(--draw-cream);color:var(--draw-deep)}
body{background:var(--draw-cream);color:var(--draw-deep)}body>header{background:var(--draw-purple);color:white;border-color:var(--draw-line)}body>header h1,body>header p,body>header strong{color:inherit}a{color:var(--draw-purple)}button.primary,button.active{background:var(--draw-purple);border-color:var(--draw-purple);color:white}.sf-main-nav{border-color:var(--draw-line)}.sf-main-nav>a,.sf-main-nav summary,.sf-main-nav details a{color:var(--draw-purple)}.sf-main-nav [aria-current=page],.sf-main-nav .current{background:var(--draw-green);color:var(--draw-deep)}.sf-main-nav a:hover,.sf-main-nav summary:hover{background:#f6d5eb}.warehouse-day-controls{background:#efe2f7;border-color:var(--draw-line)}input:focus-visible,select:focus-visible,button:focus-visible,a:focus-visible,textarea:focus-visible{outline:3px solid var(--draw-pink);outline-offset:2px}
button{background:#35116c;color:white}button.secondary{color:#35116c;background:#eadcf5}h1,h2{color:#220b4a}header strong{color:white}
</style><link rel="stylesheet" href="/warehouse-ui.css"></head><body><h1>Warehouse · pick & load</h1><p>Pick onto pallets, last stop first in your area.</p><div id="message" role="status"></div><label>Route date<input id="date" type="date"></label><button id="refresh">Refresh routes</button><label>Route<select id="routes"></select></label><label>Picking area<select id="area"><option value="freezer">Freezer</option><option value="dry">Dry</option><option value="refrigerated">Refrigerated / fresh</option></select></label><div id="work"></div><script>
const $=id=>document.getElementById(id);let session,data,current,pending=null,busy=false;
function el(tag,text){const n=document.createElement(tag);if(text!==undefined)n.textContent=text;return n;}
function message(text,error=false){$('message').textContent=text;$('message').className=error?'warning':'card ok';}
async function api(path,body){const r=await fetch('/api/warehouse'+path,{method:body?'POST':'GET',headers:body?{'Content-Type':'application/json','x-warehouse-csrf':session.csrf}:{},body:body?JSON.stringify(body):undefined,credentials:'same-origin'});const d=await r.json();if(!r.ok)throw Error(d.error||'Could not confirm that save.');return d;}
async function refresh(){try{if(!session)session=await api('/session');data=await api('/picking');const prior=$('routes').value;$('routes').replaceChildren();for(const r of data.routes.filter(r=>r.date===$('date').value)){const o=el('option',r.name+' · '+r.status);o.value=r.id;$('routes').append(o);}if([...$('routes').options].some(o=>o.value===prior))$('routes').value=prior;draw();}catch(e){message(e.message,true);}}
function field(parent,label,value,type='text'){const l=el('label',label),i=el('input');i.type=type;i.value=value;l.append(i);parent.append(l);return i;}
function button(parent,label,action){const b=el('button',label);b.onclick=action;b.disabled=busy;parent.append(b);return b;}
async function save(name,args){if(busy)return;busy=true;pending={requestId:crypto.randomUUID(),baseRevision:data.revision,command:{name,args}};draw();await send();}
async function send(){try{const result=await api('/picking',pending);pending=null;data=result;message(result.message||'Saved.');}catch(e){message(e.message+' The save has not been confirmed. Retry the same save before scanning again.',true);}finally{busy=false;draw();}}
function draw(){const box=$('work');box.replaceChildren();current=data?.routes.find(r=>r.id===$('routes').value);if(pending){const c=el('div');c.className='card warning';c.append(el('p','An earlier save needs confirmation.'));button(c,'Retry saved action',()=>{busy=true;draw();send();});button(c,'Refresh and review before discarding this request',async()=>{if(confirm('Review the latest count before scanning again. A previous save may already have been applied.')){pending=null;await refresh();}});box.append(c);return;}if(!current){box.append(el('p','No routes sent to picking for this date.'));return;}
const total=current.lines.reduce((n,l)=>n+l.qty,0),picked=current.lines.reduce((n,l)=>n+l.picked,0),p=el('progress');p.max=total||1;p.value=picked;box.append(el('h2',Math.floor(total?100*picked/total:100)+'% · '+picked+' / '+total+' packs'),p);
if(current.hold){message('Office review is holding this route. Ask the office to resolve the change.',true);return;}if(current.status==='loaded'){box.append(el('h2','Loading confirmed for this route'));return;}
const area=$('area').value,lines=current.lines.filter(l=>l.zone===area),next=lines.find(l=>l.picked<l.qty);if(next){const c=el('section');c.className='card';c.append(el('small','Stop '+next.stop+' · '+next.customer),el('h2',next.name));const count=el('div',(next.qty-next.picked)+' remaining');count.className='count';c.append(count);const form=el('form'),barcode=field(form,'Scan or type barcode / SKU','');barcode.autocomplete='off';const quantity=field(form,'Quantity per scan',1,'number');quantity.min=1;quantity.max=next.qty-next.picked;form.append(el('small','Bulk quantity is available while more than '+next.scanLimit+' remain.'));const submit=el('button','Confirm barcode');submit.disabled=busy;form.append(submit);form.onsubmit=e=>{e.preventDefault();const code=barcode.value.trim();if(code)save('scan',[current.id,next.order,next.index,code,Number(quantity.value),{bulk:Number(quantity.value)>1,area}]);};c.append(form);if(next.manualPickAllowed)button(c,'Office-approved manual pick',()=>{const reason=prompt('Why are you picking without a barcode?');if(reason)save('manualPick',[current.id,next.order,next.index,Number(quantity.value),reason,{area}]);});box.append(c);}else box.append(el('h2','This picking area is complete'));
if(picked===total){const c=el('section');c.className='card ok';c.append(el('h2','Ready to load this route'));const vehicle=el('select');vehicle.append(el('option','Vehicle not recorded'));vehicle.options[0].value='';for(const v of data.vehicles||[]){const o=el('option',v.name);o.value=v.id;vehicle.append(o);}c.append(el('p','Vehicle tracking is optional.'),vehicle);const confirm=el('input');confirm.type='checkbox';const l=el('label','Every pallet, including fresh fruit, is on the vehicle');l.prepend(confirm);c.append(l);button(c,'Confirm route loaded',()=>{if(!confirm.checked){message('Confirm the pallets are on the vehicle first.',true);return;}save('confirmLoaded',[current.id,{freshFruit:true,...(vehicle.value?{vehicle:vehicle.value}:{})}]);}).className='primary';box.append(c);}
const list=el('details');list.append(el('summary','Remaining pick list'));for(const l of lines.filter(l=>l.picked<l.qty))list.append(el('p','Stop '+l.stop+' · '+l.name+' · '+(l.qty-l.picked)+' remaining'));box.append(list);
}
window.addEventListener('zebra-scan',e=>{if(busy||pending)return;const form=$('work').querySelector('form');if(form){form.querySelector('input').value=String(e.detail||'');form.requestSubmit();}});
$('refresh').onclick=refresh;$('date').onchange=refresh;$('routes').onchange=draw;$('area').onchange=draw;const d=new Date();$('date').value=[d.getFullYear(),String(d.getMonth()+1).padStart(2,'0'),String(d.getDate()).padStart(2,'0')].join('-');refresh();
</script></body></html>
