<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Warehouse picking</title><style>
*{box-sizing:border-box}body{font:17px system-ui;margin:0;padding:18px;background:#f4f7f3;color:#193d31}h1{font-size:27px}button,input,select{font:inherit;min-height:48px;padding:10px;border:1px solid #b9cbbf;border-radius:8px;max-width:100%}button{background:#235c47;color:white;cursor:pointer}button:disabled{opacity:.5}.row{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}.card{background:white;border:1px solid #d6e1d7;border-radius:12px;padding:16px;margin:14px 0}.warning{background:#fff0ec;padding:12px;border-radius:8px}.ok{background:#e1efdf}label{display:block;margin:12px 0}input:not([type=checkbox]),select{width:100%}.count{font-size:34px;font-weight:700;color:#a72e28}.primary{width:100%;font-weight:700}small{color:#5b7164}#message{white-space:pre-line}progress{width:100%;height:18px}summary{padding:12px;cursor:pointer}

/* D RAW website palette; operational status colors remain explicit. */
:root{--draw-cream:#fff4e8;--draw-deep:#220b4a;--draw-green:#91d729;--draw-pink:#ed168b;--draw-purple:#35116c;--draw-line:#dcd4e6;background:var(--draw-cream);color:var(--draw-deep)}
body{background:var(--draw-cream);color:var(--draw-deep)}body>header{background:var(--draw-purple);color:white;border-color:var(--draw-line)}body>header h1,body>header p,body>header strong{color:inherit}a{color:var(--draw-purple)}button.primary,button.active{background:var(--draw-purple);border-color:var(--draw-purple);color:white}.sf-main-nav{border-color:var(--draw-line)}.sf-main-nav>a,.sf-main-nav summary,.sf-main-nav details a{color:var(--draw-purple)}.sf-main-nav [aria-current=page],.sf-main-nav .current{background:var(--draw-green);color:var(--draw-deep)}.sf-main-nav a:hover,.sf-main-nav summary:hover{background:#f6d5eb}.warehouse-day-controls{background:#efe2f7;border-color:var(--draw-line)}input:focus-visible,select:focus-visible,button:focus-visible,a:focus-visible,textarea:focus-visible{outline:3px solid var(--draw-pink);outline-offset:2px}
button{background:#35116c;color:white}button.secondary{color:#35116c;background:#eadcf5}h1,h2{color:#220b4a}header strong{color:white}

body{background:#fff4e8;color:#220b4a}button{background:#411575;border-color:#411575;color:white;border-radius:13px}button.secondary{background:#eee5fa;color:#35116c;border-color:#d4c3e7}.card{border-color:#e2d6ef;border-radius:18px}.route-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px}.route-card{text-align:left;display:flex;flex-direction:column;gap:9px;padding:20px;background:white;color:#220b4a;border:2px solid #d4c3e7}.route-card strong{font-size:22px}.route-card small{color:#655474}.areas{display:flex;gap:8px;flex-wrap:wrap}.areas button{flex:1}.big-remaining{font-size:44px;color:#b52828;font-weight:800}.pick-heading{position:sticky;top:0;background:#fff4e8;padding:8px 0;z-index:4}.feedback{position:fixed;top:12px;left:4%;right:4%;z-index:1000;box-shadow:0 8px 30px #0004;padding:18px;border-radius:18px;background:#fff0ee;border:3px solid #bd1c2e;color:#8b1421;display:flex;align-items:center;gap:15px}.feedback .symbol{font-size:60px;font-weight:900}.feedback.success{border-color:#6c3c95;background:#f3e8ff;color:#35116c}.feedback button{min-width:48px}.feedback p{margin:4px 0}.not-picked{background:#fff3d1;border:2px solid #daac43}.pick-list button{width:100%;text-align:left;background:#fff0f0;color:#761a26;border-color:#e6b1b1;margin:5px 0}.pick-list small{display:block;color:inherit}dialog{border:1px solid #d4c3e7;border-radius:20px;max-width:94vw;width:620px;max-height:92dvh;overflow:auto;background:#fff4e8;color:#220b4a}dialog::backdrop{background:#25104499}dialog textarea{width:100%;font:inherit;border-radius:12px;padding:12px;min-height:90px}.dialog-actions{position:sticky;bottom:-18px;background:#fff4e8;padding:12px 0;display:flex;gap:8px;flex-wrap:wrap}.dialog-actions .primary{flex:1}.count{color:#35116c}progress{accent-color:#6e2eaa}.summary-counts{display:flex;gap:15px;flex-wrap:wrap;font-size:17px}#message:empty{display:none}#message{white-space:pre-wrap}a{color:#411575}small{color:#655474}label input[type=checkbox]{margin-right:10px}[hidden]{display:none!important}
 .remaining-list{margin:18px 0;border:1px solid #d4c3e7;border-radius:16px;padding:8px 12px}.remaining-list summary{font-weight:700;color:#35116c}.pick-list h3{margin:20px 0 8px;font-size:19px}
 .feedback{top:auto;bottom:12px;max-height:28dvh;overflow:auto;padding:12px;gap:10px}.feedback .symbol{font-size:42px}.feedback p{font-size:16px}#active-pick-summary{scroll-margin-block:24dvh}.pick-complete{background:#eaf5de;border:2px solid #87b94e}.pick-complete .big-remaining{color:#397223}
</style><link rel="stylesheet" href="/warehouse-ui.css"></head><body><h1>Warehouse pick & load</h1><div id="message" role="status"></div><div id="route-picker"><div class="row"><label>Route date<input id="date" type="date"></label><button id="refresh" class="secondary">Refresh routes</button></div><div id="route-cards" class="route-cards"></div></div><div id="work"></div><script type="module" src="/workspaces-assets/warehouse-picking.js"></script></body></html>
