<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Receive products / PO · D’ RAW</title><link rel="stylesheet" href="/warehouse-ui.css"></head><body><main><h1>Receive products / PO</h1><p>Receive a saved PO, or record a delivery / vendor pickup without a PO. Accepted frozen stock is placed separately; damaged or rejected stock stays excluded.</p><p id="message" role="status"></p><section class="card"><form id="receive"><label>Receive against<select id="po"><option value="">Direct receiving · no PO</option></select></label><label id="vendor-label">Vendor<select id="vendor" required></select></label><label id="po-reference-label">PO number / supplier reference · optional<input id="po-reference" maxlength="100" placeholder="Enter a PO number if available"></label><label>Receiving type<select id="mode"><option value="warehouse">Warehouse receiving</option><option value="vendor-pickup">Supplier pickup</option></select></label><label>Find product / SKU<input id="search" autocomplete="off"></label><div id="results"></div><div id="lines"></div><label>Notes<textarea id="notes" maxlength="2000"></textarea></label><button class="primary">Save received products</button><button type="button" id="keyboard">Hide keyboard</button></form></section><section class="card"><h2>Recent receipts</h2><div id="receipts"></div></section><dialog id="putaway"><form id="place"><h2>Confirm frozen product placement</h2><div id="allocations"></div><p id="unplaced"></p><button class="primary">Confirm actual placement</button><button type="button" id="close">Cancel</button></form></dialog></main><script>
const $=id=>document.getElementById(id);let session,lookups,pos=[],lines=[],receipt,allocations=[],pending=null,busy=false;async function api(path,body){const r=await fetch('/api/warehouse'+path,{credentials:'same-origin',cache:'no-store',...(body?{method:'POST',headers:{'Content-Type':'application/json','X-Warehouse-CSRF':session.csrf},body:JSON.stringify(body)}:{})});const d=await r.json();if(!r.ok)throw Error(d.error||'Receiving unavailable.');return d;}function node(tag,text){const n=document.createElement(tag);if(text)n.textContent=text;return n;}function field(parent,title,type,value){const label=node('label',title),input=node('input');input.type=type;input.value=value??'';if(type==='number'){input.min=0;input.step='any';}label.append(input);parent.append(label);return input;}function draw(){const box=$('lines');box.replaceChildren();for(const line of lines){const c=node('section');c.className='card';c.append(node('h3',line.name));for(const [key,label,type] of [['receivedQty','Received quantity','number'],['damagedQty','Damaged quantity','number'],['rejectedQty','Rejected quantity','number'],['lotNumber','Lot / batch','text'],['exceptionReason','Damage, rejection or over-delivery reason','text']]){const input=field(c,label,type,line[key]);input.oninput=()=>line[key]=type==='number'?Number(input.value):input.value;}if(!$('po').value){const select=node('select');select.required=true;select.append(new Option('Choose storage area',''));for(const [value,text] of [['frozen','Frozen'],['dry','Dry'],['refrigerated','Refrigerated']])select.append(new Option(text,value));select.value=line.area;select.onchange=()=>line.area=select.value;c.append(select);}box.append(c);}}function add(p){if(lines.some(l=>l.skuId===p.id))return;lines.push({skuId:p.id,name:p.name,receivedQty:1,damagedQty:0,rejectedQty:0,lotNumber:'',exceptionReason:'',area:''});draw();}function search(){const q=$('search').value.trim().toUpperCase();$('results').replaceChildren();if(!q)return;for(const p of lookups.products.filter(p=>[p.name,p.qbo_sku].some(v=>String(v||'').toUpperCase().includes(q))).slice(0,20)){const b=node('button',p.name+' · '+(p.qbo_sku||''));b.type='button';b.onclick=()=>{add(p);$('search').value='';$('results').replaceChildren();};$('results').append(b);}}$('search').oninput=search;window.addEventListener('zebra-scan',e=>{$('search').value=String(e.detail?.barcode||e.detail||'');search();});$('po').onchange=()=>{const po=pos.find(p=>p.id===$('po').value);$('vendor-label').hidden=!!po;$('po-reference-label').hidden=!!po;$('vendor').required=!po;lines=po?po.lines.map(l=>({...l,poLineId:l.id,receivedQty:0,damagedQty:0,rejectedQty:0,lotNumber:'',exceptionReason:''})):[];draw();};async function savePending(){if(busy||!pending)return;busy=true;try{const result=await api(pending.path,pending.body);localStorage.removeItem('draw-receiving-save:'+session.user.id);pending=null;$('message').textContent='Receipt saved. Confirm actual putaway to register accepted frozen inventory.';lines=[];draw();await listReceipts();}catch(e){$('message').textContent=e.message+' Use Retry save; the same request is retained.';if(!$('retry')){const b=node('button','Retry save');b.id='retry';b.onclick=savePending;$('message').after(b);}}finally{busy=false;if(!pending)$('retry')?.remove();}}$('receive').onsubmit=async e=>{e.preventDefault();if(pending)return savePending();if(!lines.some(l=>l.receivedQty>0)){$('message').textContent='Enter the quantity actually received for at least one product.';return;}const po=pos.find(p=>p.id===$('po').value);pending={path:po?'/receipts':'/receipts/direct',body:{requestId:crypto.randomUUID(),...(po?{poId:po.id,expectedPORevision:po.revision}:{vendorId:$('vendor').value,poNumber:$('po-reference').value.trim()}),mode:$('mode').value,notes:$('notes').value,lines:lines.filter(l=>l.receivedQty>0).map(l=>({...l}))}};localStorage.setItem('draw-receiving-save:'+session.user.id,JSON.stringify(pending));await savePending();};async function listReceipts(){const result=await api('/receipts');$('receipts').replaceChildren();for(const r of result.receipts){const c=node('section');c.className='card';c.append(node('h3',new Date(r.received_at).toLocaleString()+' · '+r.mode),node('p',r.status));for(const l of r.lines)c.append(node('p',l.name+' · accepted '+l.goodQty+' · damaged '+l.damagedQty+' · rejected '+l.rejectedQty));if(!r.putaway_at){const b=node('button','Plan / confirm putaway');b.onclick=()=>plan(r).catch(e=>$('message').textContent=e.message);c.append(b);}$('receipts').append(c);}}async function plan(r){receipt=r;const options={};for(const line of r.lines.filter(l=>l.area==='frozen')){const config=lookups.palletConfigs.find(c=>c.sku_id===line.skuId&&c.is_default)||lookups.palletConfigs.find(c=>c.sku_id===line.skuId);if(!config)throw Error('Set a pallet size for '+line.name+' before suggesting storage.');const qty=prompt('How many accepted units of '+line.name+' should stay in the walk-in freezer for restocking?','0');if(qty===null)return;options[line.id]={palletConfigId:config.id,walkinQty:Number(qty)};}const result=await api('/receipts/'+encodeURIComponent(r.id)+'/suggestions',{options});allocations=result.allocations;$('allocations').replaceChildren();for(const a of allocations){const line=r.lines.find(l=>l.id===a.receiptLineId),c=node('section');c.append(node('h3',line.name),node('p',a.qty+' units · '+a.purpose));const input=field(c,'Actual position','text',a.locationCode);input.oninput=()=>a.locationCode=input.value.toUpperCase();$('allocations').append(c);}$('unplaced').textContent=result.unplaced.map(x=>x.qty+' units: '+x.reason).join('; ');$('place').querySelector('button').disabled=!!result.unplaced.length;$('putaway').showModal();}$('place').onsubmit=async e=>{e.preventDefault();if(!confirm('Confirm the products are physically in these positions?'))return;try{const key='draw-putaway:'+session.user.id+':'+receipt.id;let request=JSON.parse(localStorage.getItem(key)||'null');if(!request){request={requestId:crypto.randomUUID(),expectedRevision:receipt.revision,confirmed:true,allocations};localStorage.setItem(key,JSON.stringify(request));}await api('/receipts/'+encodeURIComponent(receipt.id)+'/putaway',request);localStorage.removeItem(key);$('putaway').close();await listReceipts();$('message').textContent='Putaway saved and audited. Office review remains separate.';}catch(e){$('message').textContent=e.message;}};$('close').onclick=()=>$('putaway').close();$('keyboard').onclick=()=>document.activeElement?.blur();(async()=>{session=await api('/session');lookups=await api('/receiving-lookups');pos=(await api('/purchase-orders')).purchaseOrders;for(const vendor of lookups.vendors)$('vendor').append(new Option(vendor.name,vendor.id));for(const p of pos.filter(p=>p.status!=='closed'))$('po').append(new Option(p.po_number+' · '+p.vendor_name,p.id));await listReceipts();pending=JSON.parse(localStorage.getItem('draw-receiving-save:'+session.user.id)||'null');if(pending){$('message').textContent='A previous receipt needs confirmation. Retry the saved action before receiving again.';const b=node('button','Retry saved receipt');b.onclick=savePending;$('message').after(b);}})().catch(e=>$('message').textContent=e.message);
</script></body></html>
