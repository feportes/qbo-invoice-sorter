<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Freezer & container map</title>
<style>
:root{--ink:#183747;--muted:#52636d;--line:#c5d0d5;--fill:#eef4f5}*{box-sizing:border-box}body{font-family:system-ui,sans-serif;margin:24px;color:var(--ink);background:#f5f7f8}h1{margin:0;font-size:28px}h2{margin:0;font-size:20px}h3{margin:0;font-size:15px}a{color:#165876}button,.button{font:inherit;border:1px solid var(--line);border-radius:6px;padding:8px 10px;background:white;color:var(--ink);cursor:pointer}nav,.toolbar{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin:14px 0}.muted{color:var(--muted);font-size:13px}.yard{display:grid;grid-template-columns:repeat(2,minmax(300px,1fr));gap:20px;align-items:start}.container,.special{background:white;border:1px solid var(--line);border-radius:12px;padding:16px}.container header{display:flex;justify-content:space-between;align-items:center}.end{text-align:center;font-size:12px;font-weight:700;letter-spacing:1px;margin:10px 0}.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.lane{display:flex;flex-direction:column;gap:5px}.lane .slot{flex:1 0 auto}.slot{border:1px solid var(--line);border-radius:5px;padding:7px;min-height:74px;overflow-wrap:anywhere}.occupied{background:var(--fill)}.slot.drop-hover,.special.drop-hover{outline:3px dashed #16836b}.pallet{cursor:grab}.pallet.selected{outline:3px solid #16836b}.code{font-size:11px;color:var(--muted)}.product{font-size:13px;font-weight:700;margin:3px 0}.qty{font-size:12px}.actions{display:flex;gap:9px;align-items:center;margin-top:5px;font-size:11px}.actions button{padding:3px 6px;font-size:11px}.empty{font-size:12px;color:var(--muted);margin-top:8px}.specials{display:grid;grid-template-columns:2fr 1fr;gap:20px;margin:20px 0}.cards{display:flex;gap:10px;flex-wrap:wrap;margin-top:10px}.cards .pallet{border:1px solid var(--line);border-radius:6px;padding:10px;min-width:170px;max-width:280px}table{width:100%;font-size:12px;border-collapse:collapse;margin-top:12px}td,th{text-align:left;padding:5px;border-bottom:1px solid var(--line)}.dim{opacity:.3}#moveStatus,.msg{padding:12px;background:#e1f1ea;border-radius:6px;margin:12px 0}input[type=search]{font:inherit;padding:8px;border:1px solid var(--line);border-radius:6px;min-width:260px}.long .slot{min-height:60px}.long{border-top:4px solid #628f9d}.copy-target{outline:3px solid #16836b;background:#e1f1ea}#copyPanel{position:sticky;top:0;z-index:5;padding:12px;border:2px solid #16836b;border-radius:8px;background:#eef9f3}#copyPanel input{font:inherit;padding:6px;max-width:160px}#copyPanel .toolbar{margin:8px 0}button:disabled{opacity:.5;cursor:default}.notes{white-space:pre-wrap;font-size:11px;margin-top:4px}
@media(max-width:750px){body{margin:12px}.yard,.specials{grid-template-columns:1fr}.slot{min-height:82px}.actions{flex-wrap:wrap}}
@media print{@page{size:letter portrait;margin:.4in}body{background:white;margin:0;color:black}nav,.toolbar,.actions,.specials,#moveStatus,#copyPanel,.screen,.msg{display:none!important}.yard{display:block}.container{break-after:page;border:0;padding:0}.container:last-child{break-after:auto}.slot{min-height:48px!important;border-color:#777;padding:4px}.lane{gap:3px}.dim{opacity:1}.container h2{font-size:25px}.grid{gap:30px}.product{font-size:12px}.end{margin:9px 0}.notes{font-size:10px}}
</style></head><body>
<h1>Freezer & container map</h1>
<p class="muted">40 x 48 in pallets. Left and right as viewed from the door. Existing slot 01 stays nearest the door.</p>
<nav><a href="/">Home</a><a href="/inventory/map?c=1">Detailed map</a><a href="/inventory/walkin">Walk-in freezer</a><a href="/inventory/returns">Returns</a><a href="/inventory/settings/containers">Layouts</a><a href="/inventory/settings/skus">Products / sync</a><a href="/inventory/loading-notes">Oct 30 loading notes</a><a href="/inventory/add-pallet?c=1">+ Add pallet / mixed</a></nav>
<% if (msg) { %><div class="msg"><%= msg %></div><% } %>
<div class="toolbar"><input id="search" type="search" placeholder="Find a product or lot" aria-label="Find a product or lot"><button onclick="location.reload()">Refresh</button><label><input id="auto" type="checkbox" checked> Refresh every 30 sec</label><button onclick="window.print()">Print container maps</button></div>
<div id="moveStatus" hidden aria-live="polite"></div>
<section id="copyPanel" hidden><strong id="copyTitle"></strong><div id="copyDescription" class="muted"></div><div class="toolbar"><label id="copyQtyLabel">Quantity per new pallet <input id="copyQty" type="number" min=".01" step="any"></label><button id="pasteCopies" type="button" disabled>Add copies</button><button id="cancelCopy" type="button">Done / cancel</button></div><div id="copyStatus" aria-live="polite">Tap empty slots to select destinations.</div><div class="muted">Each copy adds a new pallet to stock. Products and quantities are copied. Adjust partial counts after copying.</div></section>
<p class="muted screen">Drag pallets between locations, or tap Move then tap an unoccupied destination. No recorded pallet does not confirm a physically empty slot.</p>
<% const drawPallet = (p) => { %>
<div class="pallet" draggable="true" data-pallet-id="<%= p.id %>" data-copy-fingerprint="<%= p.copy_fingerprint %>" data-items="<%= JSON.stringify(p.items.map(i=>({name:i.sku_name,qty:i.qty_units,unit:i.unit_type}))) %>" data-search="<%= p.items.map(i=>i.sku_name+' '+(i.lot_number||'')).join(' ').toLowerCase() %>">
<% if(p.items.length>1){ %><div class="product">Mixed pallet</div><% } %>
<% p.items.forEach(i=>{ %><div class="product"><%= i.sku_name %></div><div class="qty"><%= i.qty_units %> <%= i.unit_type %> &middot; <%= i.status %><% if(i.lot_number) { %> &middot; Lot <%= i.lot_number %><% } %></div><% if(i.notes) { %><div class="notes"><%= i.notes %></div><% } %><% }); %>
<div class="actions"><button type="button" data-select-pallet="<%= p.id %>">Move</button><button type="button" data-copy-pallet="<%= p.id %>">Copy pallet</button><a href="/inventory/pallet/<%= p.id %>">Count / notes</a><span>#<%= p.id %></span></div></div>
<% }; %>
<div class="specials">
<section class="special" data-slot="WALKIN"><h2>Walk-in freezer</h2><div class="muted">Move whole pallets here, or use the detailed map to break quantities into loose stock.</div><div class="cards"><% walkinPallets.forEach(drawPallet); %></div>
<% if(walkinLoose.length) { %><table><thead><tr><th>Loose product</th><th>Lot</th><th>Quantity</th></tr></thead><tbody><% walkinLoose.forEach(p=>{ %><tr><td><%= p.sku_name %></td><td><%= p.lot_number || '' %></td><td><%= p.qty_units %> <%= p.unit_type %></td></tr><% }); %></tbody></table><% } %>
</section>
<section class="special" data-slot="RETURNS"><h2>Returns / staging</h2><div class="cards"><% returnsPallets.forEach(drawPallet); %></div></section>
</div>
<div class="yard">
<% yard.forEach(c=>{ %><section class="container"><header><h2>Container <%= c.containerNo %></h2><a class="screen" href="/inventory/map?c=<%= c.containerNo %>">Details</a></header><div class="muted"><%= c.containerNo===1?'20 ft':'40 ft' %> &middot; <%= c.layout.label %></div><div class="end">BACK / CLOSED END</div><div class="grid">
<% [['L',c.left],['R',c.right]].forEach(([side,slots])=>{ const sideways=slots.length===(c.containerNo===1?5:11); %><div class="lane <%= sideways?'long':'' %>"><h3><%= side==='L'?'LEFT':'RIGHT' %> &middot; <%= sideways?'sideways':'straight' %></h3>
<% [...slots].reverse().forEach((s,i)=>{ %><div class="slot <%= s.pallet?'occupied':'' %>" data-slot="<%= s.code %>" data-occupied="<%= s.pallet?'1':'0' %>"><div class="code"><b><%= side %><%= i+1 %> from back</b> &middot; slot <%= s.code %></div><% if(s.pallet) { drawPallet(s.pallet); } else { %><div class="empty">No pallet recorded</div><a class="screen" style="font-size:11px" href="/inventory/add-pallet?c=<%= c.containerNo %>&slot=<%= encodeURIComponent(s.code) %>">+ Add pallet</a><% } %></div><% }); %></div><% }); %>
</div><div class="end">DOOR / ENTRANCE</div><% if(c.unmappedPallets.length){ %><aside style="border:2px solid #c68d30;padding:10px"><b>Location review needed</b><p class="muted">Stock outside this layout or sharing a slot. Move these pallets to their correct locations.</p><% c.unmappedPallets.forEach(p=>{ %><div class="code"><%= p.location_code %></div><% drawPallet(p); }); %></aside><% } %></section><% }); %>
</div>
<script>
let selectedPallet=null, moving=false, copySource=null;
const selectedSlots=new Set();
const statusBox=document.getElementById('moveStatus'),copyPanel=document.getElementById('copyPanel'),copyStatus=document.getElementById('copyStatus'),pasteButton=document.getElementById('pasteCopies');
function resetSelection(){selectedPallet=null;copySource=null;selectedSlots.clear();copyPanel.hidden=true;statusBox.hidden=true;document.querySelectorAll('.selected,.copy-target').forEach(p=>p.classList.remove('selected','copy-target'));}
function selectPallet(id){resetSelection();selectedPallet=id;document.querySelectorAll('.pallet').forEach(p=>p.classList.toggle('selected',p.dataset.palletId===String(id)));statusBox.hidden=false;statusBox.textContent='Pallet #'+id+': tap an unoccupied destination, Walk-in, or Returns. ';const cancel=document.createElement('button');cancel.textContent='Cancel';cancel.onclick=resetSelection;statusBox.append(cancel);}
function updateCopySummary(){pasteButton.disabled=moving||selectedSlots.size===0;pasteButton.textContent='Add '+selectedSlots.size+' '+(selectedSlots.size===1?'copy':'copies');copyStatus.textContent=selectedSlots.size ? 'Selected: '+[...selectedSlots].join(', ') : 'Tap empty slots to select destinations.';}
function selectCopy(id){const card=[...document.querySelectorAll('.pallet')].find(p=>p.dataset.palletId===String(id));if(!card)return;resetSelection();copySource=card;card.classList.add('selected');copyPanel.hidden=false;const items=JSON.parse(card.dataset.items);document.getElementById('copyTitle').textContent='Copy '+(items.length>1?'mixed pallet':items[0].name)+' #'+id;document.getElementById('copyDescription').textContent=items.map(i=>i.name+': '+i.qty+' '+i.unit).join(' | ');document.getElementById('copyQtyLabel').hidden=items.length>1;document.getElementById('copyQty').value=items[0].qty;updateCopySummary();copyPanel.scrollIntoView({block:'start'});}
async function move(id,slot){if(moving)return;moving=true;try{const r=await fetch('/inventory/move-json',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({pallet_id:id,to_location_code:slot})});const j=await r.json();if(!r.ok||!j.ok)throw new Error(j.error||'Unable to save move');location.reload();}catch(e){alert(e.message);moving=false;}}
document.querySelectorAll('[data-select-pallet]').forEach(b=>b.onclick=e=>{e.stopPropagation();selectPallet(b.dataset.selectPallet);});
document.querySelectorAll('[data-copy-pallet]').forEach(b=>b.onclick=e=>{e.stopPropagation();selectCopy(b.dataset.copyPallet);});
document.getElementById('cancelCopy').onclick=()=>{if(!moving)resetSelection();};
pasteButton.onclick=async()=>{
 if(!copySource||!selectedSlots.size||moving)return;
 const qty=document.getElementById('copyQty').value;
 if(JSON.parse(copySource.dataset.items).length===1&&(!Number.isFinite(Number(qty))||Number(qty)<=0)){copyStatus.textContent='Enter a quantity greater than zero.';return;}
 moving=true;pasteButton.disabled=true;document.getElementById('cancelCopy').disabled=true;copyStatus.textContent='Saving copies...';
 try{const r=await fetch('/inventory/copy-pallets',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({source_pallet_id:copySource.dataset.palletId,expected_items:copySource.dataset.copyFingerprint,qty_units:qty,location_codes:[...selectedSlots]})});const j=await r.json();if(!r.ok||!j.ok)throw new Error(j.error||'Unable to save copies');location.href='/inventory/yard?copy='+copySource.dataset.palletId+'&copy_qty='+encodeURIComponent(qty)+'&msg='+encodeURIComponent(j.count+' new pallets added. Select more slots or tap Done.');}
 catch(e){moving=false;updateCopySummary();document.getElementById('cancelCopy').disabled=false;copyStatus.textContent=e.message+' Refresh the map if the stock changed.';}
};
document.querySelectorAll('.pallet').forEach(p=>p.addEventListener('dragstart',e=>{if(copySource){e.preventDefault();return;}e.dataTransfer.setData('text/plain',p.dataset.palletId);}));
document.querySelectorAll('[data-slot]').forEach(s=>{
 s.addEventListener('click',e=>{
  if(copySource){if(e.target.closest('button,.pallet'))return;e.preventDefault();if(moving)return;if(s.dataset.occupied==='1'||!s.classList.contains('slot')){copyStatus.textContent='Select an empty container slot.';return;}const code=s.dataset.slot;if(selectedSlots.has(code))selectedSlots.delete(code);else if(selectedSlots.size<20)selectedSlots.add(code);s.classList.toggle('copy-target',selectedSlots.has(code));updateCopySummary();return;}
  if(e.target.closest('a,button,.pallet'))return;if(selectedPallet){if(s.dataset.occupied==='1'){alert('Destination is occupied.');return;}move(selectedPallet,s.dataset.slot);}
 });
 s.addEventListener('dragover',e=>{if(copySource||s.dataset.occupied==='1')return;e.preventDefault();s.classList.add('drop-hover');});s.addEventListener('dragleave',()=>s.classList.remove('drop-hover'));s.addEventListener('drop',e=>{e.preventDefault();s.classList.remove('drop-hover');if(copySource||s.dataset.occupied==='1')return;const id=e.dataTransfer.getData('text/plain');if(id)move(id,s.dataset.slot);});
});
document.getElementById('search').oninput=e=>{const q=e.target.value.toLowerCase();document.querySelectorAll('.pallet').forEach(p=>p.classList.toggle('dim',!p.dataset.search.includes(q)));};
setInterval(()=>{if(document.getElementById('auto').checked&&!document.hidden&&!selectedPallet&&!copySource&&!moving&&!document.getElementById('search').value&&document.activeElement===document.body)location.reload();},30000);
const initialCopy=new URLSearchParams(location.search).get('copy');if(initialCopy){selectCopy(initialCopy);const q=new URLSearchParams(location.search).get('copy_qty');if(q&&Number.isFinite(Number(q))&&Number(q)>0)document.getElementById('copyQty').value=q;}
</script></body></html>
