<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Route planning · D’ RAW</title><link rel="stylesheet" href="/warehouse-ui.css"><style>
body{font:16px system-ui;color:#251044;background:#fff4e8;margin:0;padding:16px}button,input,select,textarea{font:inherit;min-height:46px;border:1px solid #d4c3e7;border-radius:12px;padding:10px;color:#32115d;background:white}button{cursor:pointer;background:#eee5fa}button:disabled{opacity:.5}.primary{background:#411575;color:white}.danger{background:#fff0f0;color:#a21515}.toolbar,.actions{display:flex;gap:8px;flex-wrap:wrap;align-items:end;margin:12px 0}label{display:block}label input,label select{display:block;width:100%;margin-top:5px}.board{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,330px),1fr));gap:16px}.card{background:white;border:1px solid #e3d9f2;padding:16px;border-radius:20px;margin:10px 0}.stop{border:1px solid #dfd3ec;border-radius:14px;padding:12px;margin:10px 0}.location{background:#fff4ce;border:2px solid #d8a429}.sent{opacity:.8}small{display:block;color:#6b587e}.notice{padding:12px;border-radius:12px;background:#eee5fa;white-space:pre-wrap}.notice:empty{display:none}select,textarea{max-width:100%}.stop select{width:100%}dialog{width:min(94vw,620px);border:0;border-radius:18px;max-height:90vh;max-height:90dvh;overflow:auto}dialog::backdrop{background:#25104499}dialog label{margin:12px 0}textarea{width:100%}h1{font-size:29px}h2{font-size:23px}.saved{display:flex;gap:8px;flex-wrap:wrap}#pending{position:sticky;top:0;z-index:20;background:#fff0ce;padding:12px;border-radius:12px}[hidden]{display:none!important}

