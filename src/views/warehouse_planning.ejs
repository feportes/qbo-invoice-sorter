.invoice-picker{width:100%;margin:12px 0}.invoice-picker-count{font-size:13px;margin:8px 0}.invoice-picker-list{max-height:300px;max-height:min(36vh,300px);max-height:min(36dvh,300px);overflow-y:auto;overscroll-behavior:contain;touch-action:pan-y;border:1px solid #d4c3e7;border-radius:12px;padding:6px}.invoice-picker-list .invoice-picker-row{display:flex;align-items:center;gap:12px;min-height:48px;padding:10px;margin:3px 0;border-bottom:1px solid #eee;cursor:pointer}.invoice-picker-list .invoice-picker-row[hidden]{display:none!important}.invoice-picker-list .invoice-picker-row input{flex:0 0 22px;width:22px!important;min-height:22px;max-width:22px;margin:0}.invoice-picker-row:has(input:checked){background:#eee5fa;border-radius:8px}.invoice-picker input[type=search]{width:100%;box-sizing:border-box}
dialog{box-sizing:border-box;overflow-x:hidden}dialog form{min-width:0}dialog input,dialog select,dialog textarea{box-sizing:border-box;max-width:100%}.invoice-picker-row span{min-width:0;overflow-wrap:anywhere}.print-route-label{display:flex;align-items:center;gap:5px;font-size:12px;margin:0;flex:0 0 auto}.print-route-label input{display:inline-block;width:20px;min-height:20px;height:20px;margin:0}.print-selection{padding:10px;background:#eee5fa;border-radius:12px}.print-selection span{font-weight:700}
.workflow-section>summary{font-size:21px;font-weight:750;cursor:pointer;padding:6px 0}.workflow-section>summary small{display:inline;font-weight:400;font-size:14px}.invoice-scroll{max-height:360px;overflow:auto;overscroll-behavior:contain}#unassigned{max-height:420px;overflow:auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,290px),1fr));gap:10px}#unassigned .stop{margin:4px 0}.section-heading{display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap}.route-map-canvas{height:320px;border-radius:14px;background:#f2eef5}.map-choices{display:flex;flex-wrap:wrap;gap:8px;max-height:150px;overflow:auto;margin:10px 0}.map-choices label{display:flex;align-items:center;gap:7px;border:1px solid #d4c3e7;background:white;border-radius:12px;padding:8px}.map-choices input,.route-selection input{width:20px;min-height:20px;height:20px;margin:0}.map-expanded{position:fixed;inset:12px;z-index:850;margin:0;overflow:auto;box-shadow:0 0 0 100vmax #25104499}.map-expanded .route-map-canvas{height:calc(100dvh - 260px);min-height:200px}.route-selection{display:flex;align-items:center;gap:6px;font-size:13px}.map-note{font-size:13px;color:#655474}.board{align-items:start}#pickup-board:empty{display:none}.print-selection{position:sticky;top:0;z-index:15}.print-selection button{min-height:40px}.route-selection input{flex:none}#invoice-list:empty{display:none}
.map-stop-editor{font:14px system-ui;color:#251044;width:260px;max-width:100%;padding:3px;box-sizing:border-box}.map-stop-editor strong{display:block;font-size:16px}.map-stop-editor p{margin:8px 0}.map-stop-editor label{margin:10px 0}.map-stop-editor select{width:100%;box-sizing:border-box;min-height:42px}.map-stop-editor button{width:100%;background:#411575;color:white}.map-stop-editor [role=status]{font-weight:600}.map-stop-editor [role=status]:empty{display:none}.map-stop-editor label{margin:6px 0}.map-stop-editor select{min-height:38px;padding:6px}.map-stop-editor button{min-height:40px;padding:8px}.map-stop-editor summary{font-size:12px;padding:2px 0;cursor:pointer}
.overview-controls button[aria-pressed=true]{background:#411575;color:white}.stop-heading-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:10px}.stop-heading-actions .drag-handle{margin:0}.edit-stop-rule{font-size:13px}.route-actions>summary{cursor:pointer;font-weight:650;padding:8px 0}.compact-board{grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr));gap:12px}.compact-board .route-card{padding:12px;margin:0}.compact-board .route-toggle{font-size:18px}.compact-board .route-body>p{display:none}.compact-board .stop{padding:9px;margin:5px 0}.compact-board .stop>strong{font-size:14px;line-height:1.35}.compact-board .stop>small{font-size:12px;margin:3px 0}.compact-board .stop>.stop-address,.compact-board .stop>details:not(.stop-tools){display:none}.compact-board .stop-heading-actions{gap:6px;margin:0 0 5px}.compact-board .stop-heading-actions button{font-size:12px;padding:5px 8px;min-height:34px}.compact-board .stop-tools>summary{font-size:12px;padding:3px 0}.compact-board .route-actions{font-size:13px;margin:4px 0}.compact-board .stop-count{font-size:12px;padding:6px}.compact-board .print-route-label{font-size:11px}.customer-rule-dialog{width:min(94vw,740px)}.rule-day{display:grid;grid-template-columns:125px minmax(0,1fr) 85px;gap:8px;align-items:center;border-bottom:1px solid #e2d5eb}.rule-day label{display:flex;align-items:center;gap:8px}.rule-day input[type=checkbox]{width:22px;min-height:22px;margin:0}.rule-day input[type=number],.rule-day select{width:100%;min-width:0}.customer-rule-dialog [role=alert]{color:#a21529;white-space:pre-wrap}@media(max-width:500px){.rule-day{grid-template-columns:minmax(0,1fr) 85px}.rule-day>label{grid-column:1/-1;margin-bottom:0}.overview-controls{gap:5px}.overview-controls button{font-size:13px;padding:9px}}
.compact-board .stop{display:grid;grid-template-columns:32px minmax(0,1fr) 48px;gap:2px 6px;align-items:center}.compact-board .stop-heading-actions{display:contents}.compact-board .drag-handle{grid-column:1;grid-row:1 / span 2;font-size:0!important;padding:0!important;min-height:36px}.compact-board .drag-handle::before{content:'⠿';font-size:22px}.compact-board .edit-stop-rule{grid-column:3;grid-row:1 / span 2;font-size:0!important;padding:4px!important}.compact-board .edit-stop-rule::before{content:'Rule';font-size:12px}.compact-board .stop>strong{grid-column:2;grid-row:1}.compact-board .stop>small{grid-column:2;grid-row:2}.compact-board .stop-tools{grid-column:2 / -1}.compact-board .stop>label,.compact-board .stop>button{grid-column:1 / -1}.compact-board .stop-tools summary{font-size:11px}
</style></head><body><nav aria-label="Planning navigation"><a href="/workspaces">← Workspaces</a> · <a href="/warehouse-route-rules">Customer auto-assign rules</a></nav><h1>Route planning</h1><p id="message" class="notice" role="status"></p><div id="pending" role="status" hidden><span>Save not confirmed</span><button id="retry">Retry</button><details><summary>Details</summary><p id="pending-error"></p></details></div><span id="save-status" role="status"></span>
<details id="invoice-section" class="card workflow-section" open><summary>1. Import invoice stops <small id="import-count"></small></summary><div class="toolbar"><label>QuickBooks invoice date<input id="load-date" type="date"></label><button id="load-invoices" class="primary">Load QuickBooks invoices</button><button id="import-invoices" hidden>Import selected invoices</button></div><small>Choosing the invoice date sets both planning dates. You can override them below.</small><p id="invoice-status" role="status">Choose an invoice date, then load invoices.</p><div id="invoice-list" class="invoice-scroll"></div></details>
<details id="saved-section" class="card workflow-section" open><summary>2. Saved route names</summary><div class="toolbar"><label>Route date<input id="date" type="date"></label><label>Invoice date<input id="invoice-date" type="date"></label><button id="refresh">Refresh</button><button id="create">Create route</button><button type="button" id="manage-saved">Add / remove saved names</button></div><div id="saved" class="saved"></div></details>
<details id="unassigned-section" class="card" data-drop-route="__unassigned" open><summary>3. Unassigned stops <span id="unassigned-count">0 stops</span></summary><div class="actions"><button id="auto" class="primary">Auto assign customers</button><a href="/warehouse-route-rules">Edit customer rules</a><small>Assign imported stops using their saved route and stop order.</small></div><div id="unassigned"></div></details>
<details id="map-section" class="card workflow-section" open><summary>Route map <small id="map-count"></small></summary><div class="actions"><button id="map-all">Show all routes</button><button id="map-none">Hide all routes</button><button id="map-fit">Fit stops</button><button id="map-locate">Retry missing pins</button><button id="map-expand">Expand map</button><label class="route-selection"><input type="checkbox" id="map-roads" checked> Show driving routes</label></div><div id="map-choices" class="map-choices"></div><div id="planning-map" class="route-map-canvas" aria-label="Selected routes and numbered stops"></div><p id="map-status" class="map-note" role="status"></p><div id="map-issues" class="map-note" hidden></div></details>
<section aria-labelledby="routes-heading"><h2 id="routes-heading">4. Arrange routes</h2><div class="actions overview-controls" aria-label="Route overview layout"><button id="detailed-view" aria-pressed="true">Detailed view</button><button id="compact-view" aria-pressed="false">Compact overview</button><button id="collapse-routes">Collapse all routes</button><button id="expand-routes">Expand all routes</button></div><p id="route-count" role="status"></p><div class="actions print-selection"><span id="print-selection-count">0 routes selected</span><button id="select-printable">Select all</button><button id="clear-printable">Clear selection</button><button id="print-selected" disabled>Print selected routes</button><button id="send-selected" class="primary" disabled>Send selected to picking</button></div><div id="board" class="board"></div><details id="pickup-section" class="card workflow-section"><summary>Warehouse pickup orders <small id="pickup-count"></small></summary><small>Pick and stage customer collections without a driver.</small><div id="pickup-board" class="board"></div></details><details id="sent" class="card workflow-section"><summary>Sent to picking / completed routes</summary><div id="sent-board" class="board"></div></details></section><link rel="stylesheet" href="/workspaces-assets/vendor/leaflet/leaflet.css"><script src="/workspaces-assets/vendor/leaflet/leaflet.js"></script><script type="module" src="/workspaces-assets/planning.js"></script><script type="module" src="/workspaces-assets/office-notification.js"></script></body></html>
