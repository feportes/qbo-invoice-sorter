<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Temperatures & Motive · D’ RAW</title><link rel="stylesheet" href="/warehouse-ui.css"></head><body><p><a href="/warehouse-map-settings">Satellite & driving-route setup →</a></p><main><h1>Temperatures & Motive</h1><p id="message" role="status"></p><section class="card"><h2>Connection status</h2><div id="connections"></div><p>Motive driving records supplement the route audit. They do not replace product scans, delivery photos or office approval.</p><p>Temperature colors use your chosen limits. Old or missing readings are gray.</p></section><section class="card" id="mapping"><h2>Match a sensor or vehicle</h2><form id="binding"><label>Source<select name="provider"><option value="temperature">GlacierGrid sensor</option><option value="motive">Motive vehicle</option></select></label><label id="source-label">Connected vehicle / sensor<select name="sourceSelection" id="source-choice"></select></label><label id="manual-source">Sensor ID · available until GlacierGrid sensor names connect<input name="sourceId" maxlength="150"></label><label id="target-label">Match to<select name="targetId" id="target-choice" required></select></label><div id="limits"><label>Expected minimum temperature · °F<input name="expectedMinF" type="number" step="any" value="-10" required></label><label>Expected maximum temperature · °F<input name="expectedMaxF" type="number" step="any" value="10" required></label><p>−10°F through 10°F stays blue. Above 10°F: green through 15°F, yellow through 20°F, orange through 25°F, red above 25°F. You can edit the range and interval.</p><label>Each warmer color interval · °F<input name="warmingStepF" type="number" min="0.1" max="50" step="any" value="5" required></label><label>Show as stale after · minutes<input name="staleMinutes" type="number" min="1" max="1440" value="15" required></label></div><button class="primary">Save matching rule</button></form></section><section class="card"><h2>Saved matching rules</h2><div id="bindings"></div></section><section class="card"><h2>Refresh Motive driving records</h2><form id="refresh"><label>From<input name="startAt" type="datetime-local" required></label><label>Until<input name="endAt" type="datetime-local" required></label><button class="primary">Refresh from Motive</button></form><p>Uses a server-side API key, never one saved in your phone. The chat connection alone does not keep the app refreshed.</p></section><section class="card"><h2>Route driving evidence</h2><form id="route"><label>Route ID<input name="routeId" required></label><button>View evidence</button></form><div id="evidence"></div></section><details class="card"><summary>Optional Motive camera evidence · connection test</summary><p>Provider-reported events are separate from confirmed delivery activity. Review the original footage and context.</p><form id="camera-search"><label>Event date<input id="camera-date" type="date" required></label><button>View camera evidence</button></form><div id="camera-evidence"></div></details></main><script>
const $=id=>document.getElementById(id);let csrf,options={sources:[],vehicles:[],locations:[]};async function api(path,body){const r=await fetch('/api/warehouse'+path,{credentials:'same-origin',cache:'no-store',...(body?{method:'POST',headers:{'Content-Type':'application/json','X-Warehouse-CSRF':csrf},body:JSON.stringify(body)}:{})});const d=await r.json();if(!r.ok)throw Error(d.error||'Connection unavailable.');return d;}function text(parent,value){const p=document.createElement('p');p.textContent=value;parent.append(p);}async function load(){const session=await api('/session');csrf=session.csrf;$('mapping').hidden=session.user.role!=='admin';if(session.user.role==='admin'){options=await api('/connections/options');choices();}const data=await api('/connections');$('connections').replaceChildren();text($('connections'),'Motive automatic connection: '+(data.motiveAutomaticConfigured?'Configured':'API key needed on server'));text($('connections'),'GlacierGrid: awaiting confirmed API connection and sensor mapping');for(const r of data.records)text($('connections'),r.provider+' · '+r.count+' records · last imported '+new Date(r.lastFetchedAt).toLocaleString());$('bindings').replaceChildren();for(const b of data.bindings)text($('bindings'),b.provider+' · '+(options.sources.find(s=>s.provider===b.provider&&s.id===b.source_id)?.name||b.source_id)+' → '+([...(options.vehicles||[]),...(options.locations||[])].find(t=>t.id===b.target_id)?.name||b.target_id)+(b.provider==='temperature'?' · expected ≤ '+b.settings.expectedMaxF+' °F':''));}function form(id,fn){$(id).onsubmit=async e=>{e.preventDefault();const button=e.submitter;button.disabled=true;try{await fn(Object.fromEntries(new FormData($(id))));$('message').textContent='Saved / refreshed successfully.';}catch(error){$('message').textContent=error.message;}finally{button.disabled=false;}};}function choices(){const form=$('binding'),provider=form.elements.provider.value,temp=provider==='temperature',sources=options.sources.filter(s=>s.provider===provider);$('source-choice').replaceChildren(new Option(temp?'Choose a GlacierGrid sensor':'Choose a Motive vehicle',''));for(const source of sources)$('source-choice').append(new Option(source.name+(source.status?' · '+source.status:''),source.id));$('source-label').hidden=!sources.length;$('source-choice').required=!!sources.length;$('manual-source').hidden=!!sources.length;form.elements.sourceId.required=!sources.length;form.elements.sourceId.value='';const targets=temp?options.locations:options.vehicles;$('target-choice').replaceChildren(new Option(temp?'Choose container / walk-in freezer':'Choose the app vehicle',''));for(const target of targets)$('target-choice').append(new Option(target.name,target.id));$('limits').hidden=!temp;for(const input of $('limits').querySelectorAll('input'))input.required=temp;} $('source-choice').onchange=()=>{const selected=options.sources.find(s=>s.id===$('source-choice').value&&s.provider===$('binding').elements.provider.value);if(selected?.targetId)$('target-choice').value=selected.targetId;};$('binding').elements.provider.onchange=()=>{choices();const temp=$('binding').elements.provider.value==='temperature';$('limits').hidden=!temp;for(const i of $('limits').querySelectorAll('input'))i.required=temp;};form('binding',async data=>{data.sourceId=data.sourceSelection||data.sourceId;delete data.sourceSelection;await api('/connections/bindings',data);await load();});form('refresh',async data=>{await api('/connections/motive-refresh',{startAt:new Date(data.startAt).toISOString(),endAt:new Date(data.endAt).toISOString()});await load();});form('route',async data=>{const result=await api('/routes/'+encodeURIComponent(data.routeId)+'/motive');$('evidence').replaceChildren();text($('evidence'),result.status+' · '+(result.distanceMiles===null?'No verified route mileage':result.distanceMiles.toFixed(1)+' miles'));for(const r of result.records)text($('evidence'),new Date(r.startAt).toLocaleString()+' · '+r.distanceMiles.toFixed(1)+' mi · '+r.origin+' → '+r.destination);});form('camera-search',async()=>{const result=await api('/connections/camera-events?date='+encodeURIComponent($('camera-date').value));const box=$('camera-evidence');box.replaceChildren();if(!result.events.length)text(box,'No imported camera events for this date.');for(const event of result.events){const card=document.createElement('section');card.className='card';text(card,new Date(event.occurredAt).toLocaleString()+' · '+event.vehicleName+' · '+event.eventType);text(card,event.location);for(const media of event.media){const details=document.createElement('details'),summary=document.createElement('summary');summary.textContent=media.position+' camera · '+(media.mimeType.startsWith('video')?'video':'photo');details.append(summary);details.addEventListener('toggle',()=>{if(!details.open||details.querySelector('img,video'))return;const item=document.createElement(media.mimeType.startsWith('video')?'video':'img');item.src='/api/warehouse/connections/camera-events/'+encodeURIComponent(event.id)+'/'+encodeURIComponent(media.position)+'?type='+(media.mimeType.startsWith('video')?'video':'image');if(item.tagName==='VIDEO'){item.controls=true;item.playsInline=true;}else item.alt=summary.textContent;item.style='max-width:100%;max-height:450px';details.append(item);});card.append(details);}if(!event.media.length)text(card,'Event metadata saved. Footage not archived.');box.append(card);}});load().catch(e=>$('message').textContent=e.message);
</script><script type="module" src="/workspaces-assets/office-notification.js"></script></body></html>
