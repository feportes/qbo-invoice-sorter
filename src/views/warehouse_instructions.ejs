<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Store instructions · D' RAW</title><style>
*{box-sizing:border-box}body{font:16px system-ui;background:#fff4e8;color:#220b4a;margin:0;padding:18px}button,input,select,textarea{font:inherit;border:1px solid #dcd4e6;border-radius:9px;padding:12px;max-width:100%}button{cursor:pointer;background:#eadcf5;color:#35116c;margin:4px}.primary{background:#35116c;color:white}.danger{background:#a72e28;color:white}input,textarea,select{width:100%;margin:7px 0 15px}textarea{min-height:140px}label{display:block;font-weight:600}.card{background:white;border:1px solid #dcd4e6;padding:18px;margin:16px 0;border-radius:14px}pre{white-space:pre-wrap;font:inherit;line-height:1.6}small{color:#645872}img,video{display:block;max-width:100%;max-height:360px;margin:12px auto}a{color:#35116c}.badge{display:inline-block;padding:5px 12px;background:#fff0ce;border-radius:20px}dialog{border:0;border-radius:15px;padding:0;width:min(760px,96vw);height:94vh;color:#220b4a;background:#fff4e8}dialog::backdrop{background:#220b4a99}form{height:100%;display:flex;flex-direction:column}.body{padding:20px;overflow:auto;flex:1;min-height:0}.footer{padding:12px;background:white;border-top:1px solid #dcd4e6;display:flex;gap:6px;flex-wrap:wrap}.footer button{flex:1}.check{display:flex;align-items:center;gap:10px}.check input{width:24px;margin:0}.error{color:#a72e28}[hidden]{display:none!important}</style><link rel="stylesheet" href="/warehouse-ui.css"></head><body><a href="/warehouse">← Management</a><h1>Store delivery instructions</h1><p>Review driver suggestions before updating a customer or location. Approved updates reach drivers when their app reconnects.</p><button id="refresh">Refresh</button><p id="message" role="status"></p><h2>Customer & location instructions</h2><p>Find a customer to add or edit delivery instructions, lockbox/access notes and receiving details.</p><input id="search" aria-label="Find customer instructions" placeholder="Find a customer or delivery location"><p id="customer-count"></p><div id="customer-notes"></div><h2>Driver update approvals</h2><div id="queue"></div><details><summary>Approved guides, photos & videos</summary><div id="guides"></div></details>
<dialog id="customer-edit"><form id="customer-edit-form"><div class="body"><h2 id="customer-edit-title"></h2><p id="customer-edit-location"></p><label for="customer-instruction-text">Delivery instructions & access notes</label><textarea id="customer-instruction-text" maxlength="14000" style="min-height:260px"></textarea><p>Keep driver-facing delivery and access instructions here. Internal stop-time estimates stay separate.</p><div id="customer-edit-media"></div><p id="customer-edit-error" role="alert" class="error"></p><button type="button" id="reload-customer-instructions" hidden>Reload latest instructions</button></div><div class="footer"><button type="submit" class="primary" id="save-customer-instructions">Save instructions</button><button type="button" id="close-customer-edit">Cancel</button></div></form></dialog><dialog id="review"><form id="review-form"><div class="body"><h2 id="review-title"></h2><p id="origin"></p><label for="customer">Apply to customer / delivery location</label><select id="customer" required></select><label for="mode">How to apply</label><select id="mode"><option value="append">Append to current instructions</option><option value="replace">Replace current instructions</option></select><details><summary>Current approved instructions</summary><pre id="current"></pre></details><label for="instructions">Reviewed instruction text</label><textarea id="instructions" required minlength="5" maxlength="6000"></textarea><div id="media"></div><label for="reason">Review note / reason</label><textarea id="reason" required minlength="5" maxlength="1000" placeholder="Explain your approval or rejection"></textarea><p id="error" class="error" role="alert"></p></div><div class="footer"><button class="primary" id="approve" type="submit">Approve update</button><button type="button" class="danger" id="reject">Reject</button><button type="button" id="close">Cancel</button></div></form></dialog>
<script>
const $=id=>document.getElementById(id);let session,updates=[],guides=[],customers=[],selected,busy=false,editingCustomer,instructionPending;function el(tag,text){const n=document.createElement(tag);if(text!==undefined)n.textContent=text;return n;}async function api(path,body){const r=await fetch('/api/warehouse'+path,{credentials:'same-origin',headers:body?{'Content-Type':'application/json','X-Warehouse-CSRF':session.csrf}:{},...(body?{method:'POST',body:JSON.stringify(body)}:{})});const d=await r.json();if(!r.ok)throw Object.assign(Error(d.error||'Request failed'),{status:r.status});return d;}
function media(parent,m,url){const details=el('details');details.append(el('summary',m.title|| (m.mimeType==='video/mp4'?'Video':'Photo')));if(m.mimeType==='image/jpeg'){const image=el('img');image.src=url;image.loading='lazy';image.alt=m.title||'Instruction suggestion photo';details.append(image);}else{const video=el('video');video.controls=true;video.preload='none';video.src=url;details.append(video);}parent.append(details);}
function draw(){const q=$('search').value.toLowerCase();drawCustomers(q);$('queue').replaceChildren();const pending=updates.filter(u=>u.status==='pending');if(!pending.length)$('queue').append(el('p','No driver updates awaiting approval.'));for(const u of pending){const card=el('section');card.className='card';card.append(el('h3',u.customer_name),el('small',u.recorded_at+' · '+u.manifest.length+' attachments'),el('pre',u.notes));const b=el('button','Review suggestion');b.onclick=()=>open(u);card.append(b);$('queue').append(card);} $('guides').replaceChildren();for(const g of guides){if(q&&!g.title.toLowerCase().includes(q))continue;const card=el('details');card.className='card';card.append(el('summary',g.title),el('small','Updated '+g.updated_at),el('pre',g.instructions));for(const m of g.media)media(card,m,'/api/warehouse/reference-media/'+m.id);$('guides').append(card);}}
function targetGuide(){const target=customers[Number($('customer').value)];return target?guides.find(g=>g.customer_id===target.customerId&&(g.location_ref||'')===(target.referenceId||'')):null;}
function current(){const g=targetGuide();$('current').textContent=g?.instructions||customers[Number($('customer').value)]?.instructions||'No approved guide yet. This approval creates one.';}
function open(u){selected=u;$('review-title').textContent='Review instruction update';$('origin').textContent='Suggested for '+u.customer_name+' · '+u.recorded_at;$('customer').replaceChildren(new Option('Choose the correct customer and location',''));customers.forEach((c,i)=>$('customer').add(Object.assign(new Option(c.name+(c.address?' · '+c.address:''),String(i)),{disabled:!!c.needsCustomerMatch})));let index=customers.findIndex(c=>c.customerId===u.customer_id&&(c.referenceId||'')===(u.reference_id||''));$('customer').value=index<0?'':String(index);$('mode').value='append';$('instructions').value=u.notes;$('reason').value='';$('error').textContent='';$('media').replaceChildren();for(const m of u.manifest){const label=el('label');label.className='check';const input=el('input');input.type='checkbox';input.value=m.id;input.checked=true;label.append(input,el('span','Include '+(m.mimeType==='video/mp4'?'video':'photo')+' in approved guide'));$('media').append(label);media($('media'),m,'/api/warehouse/instruction-updates/'+u.id+'/media/'+m.id);}current();$('review').showModal();}
async function review(action){if(busy)return;const reason=$('reason').value.trim();if(reason.length<5){$('error').textContent='Explain your review decision.';return;}const target=customers[Number($('customer').value)];if(action==='approve'&&($('customer').value===''||!target)){$('error').textContent='Choose the correct customer and delivery location.';return;}busy=true;$('approve').disabled=$('reject').disabled=true;try{const body={action,reason,...(action==='approve'?{customerId:target.customerId,referenceId:target.referenceId||'',instructions:$('instructions').value,mode:$('mode').value,expectedUpdatedAt:targetGuide()?.updated_at||'',mediaIds:[...$('media').querySelectorAll('input:checked')].map(n=>n.value)}:{})};await api('/instruction-updates/'+selected.id+'/review',body);$('review').close();$('message').textContent=action==='approve'?'Customer instructions updated. The decision is recorded.':'Suggestion rejected; customer instructions unchanged.';await load(false);}catch(e){$('error').textContent=e.message;}finally{busy=false;$('approve').disabled=$('reject').disabled=false;}}
async function load(notify=true){try{if(!session)session=await api('/session');const r=await Promise.all([api('/reference-guides'),api('/instruction-updates'),api('/customer-instructions')]);guides=r[0].guides;updates=r[1].updates;customers=r[2].customers;draw();if(notify)$('message').textContent=r[2].warning||'Updated '+new Date().toLocaleTimeString();}catch(e){$('message').textContent=e.message;}}
$('customer').onchange=current;$('search').oninput=draw;$('review-form').onsubmit=e=>{e.preventDefault();review('approve');};$('reject').onclick=()=>review('reject');$('close').onclick=()=>$('review').close();$('refresh').onclick=()=>load();setInterval(()=>{if(!document.querySelector('dialog[open]')&&![...document.querySelectorAll('video')].some(v=>!v.paused))load(false);},30000);load();
function drawCustomers(q){const rows=customers.filter(c=>!q||[c.name,c.address].join(' ').toLowerCase().includes(q));$('customer-count').textContent=rows.length+' customer / location entries';$('customer-notes').replaceChildren();for(const c of rows){const card=el('details');card.className='card';card.append(el('summary',c.name),el('small',c.address||'Address not supplied'),el('pre',c.instructions||'No delivery instructions recorded yet.'));const edit=el('button',c.needsCustomerMatch?'Customer link needs review':c.instructions?'Edit instructions':'Add instructions');edit.disabled=!!c.needsCustomerMatch;edit.className='primary';edit.onclick=()=>openCustomer(c);card.append(edit);$('customer-notes').append(card);}if(!rows.length)$('customer-notes').append(el('p','No matching customer or location.'));}
function openCustomer(c){if(instructionPending&&(instructionPending.customerId!==c.customerId||instructionPending.referenceId!==(c.referenceId||''))){$('message').textContent='Confirm the previous instruction save before editing another customer.';return;}editingCustomer=c;$('customer-edit-title').textContent='Delivery instructions · '+c.name;$('customer-edit-location').textContent=c.address||'';$('customer-instruction-text').value=instructionPending?.instructions??c.instructions??'';$('customer-edit-error').textContent=instructionPending?'A previous save needs confirmation. Click Save instructions to retry it.':'';$('reload-customer-instructions').hidden=true;$('customer-edit-media').replaceChildren();const g=guides.find(g=>g.id===c.guideId);for(const m of g?.media||[])media($('customer-edit-media'),m,'/api/warehouse/reference-media/'+m.id);$('customer-instruction-text').disabled=!!instructionPending;$('customer-edit').showModal();$('customer-edit-title').tabIndex=-1;$('customer-edit-title').focus();}
$('customer-edit-form').onsubmit=async e=>{e.preventDefault();if(busy)return;busy=true;$('save-customer-instructions').disabled=true;$('customer-edit-error').textContent='Saving instructions…';try{instructionPending??={requestId:crypto.randomUUID(),customerId:editingCustomer.customerId,referenceId:editingCustomer.referenceId||'',expectedVersion:editingCustomer.version,instructions:$('customer-instruction-text').value};await api('/customer-instructions',instructionPending);instructionPending=null;$('customer-edit').close();await load(false);$('message').textContent='Customer delivery instructions saved. The change is recorded in the audit trail.';}catch(error){if([400,403,404,409,422].includes(error.status)){instructionPending=null;$('customer-instruction-text').disabled=false;$('reload-customer-instructions').hidden=error.status!==409;}$('customer-edit-error').textContent=error.message+(instructionPending?' Retry Save instructions to confirm the same save.':'');if(instructionPending)$('customer-instruction-text').disabled=true;}finally{busy=false;$('save-customer-instructions').disabled=false;}};
$('reload-customer-instructions').onclick=async()=>{const id=editingCustomer.customerId,ref=editingCustomer.referenceId;await load(false);const latest=customers.find(c=>c.customerId===id&&c.referenceId===ref);if(latest){$('customer-edit').close();openCustomer(latest);}};
$('close-customer-edit').onclick=()=>$('customer-edit').close();
for(const id of ['customer-edit','review'])$(id).addEventListener('click',e=>{if(e.target!==e.currentTarget)return;const r=e.currentTarget.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)e.currentTarget.close();});
</script><script type="module" src="/workspaces-assets/office-notification.js"></script></body></html>
