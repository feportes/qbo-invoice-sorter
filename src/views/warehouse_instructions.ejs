<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Store instructions · D' RAW</title><style>
*{box-sizing:border-box}body{font:16px system-ui;background:#fff4e8;color:#220b4a;margin:0;padding:18px}button,input,select,textarea{font:inherit;border:1px solid #dcd4e6;border-radius:9px;padding:12px;max-width:100%}button{cursor:pointer;background:#eadcf5;color:#35116c;margin:4px}.primary{background:#35116c;color:white}.danger{background:#a72e28;color:white}input,textarea,select{width:100%;margin:7px 0 15px}textarea{min-height:140px}label{display:block;font-weight:600}.card{background:white;border:1px solid #dcd4e6;padding:18px;margin:16px 0;border-radius:14px}pre{white-space:pre-wrap;font:inherit;line-height:1.6}small{color:#645872}img,video{display:block;max-width:100%;max-height:360px;margin:12px auto}a{color:#35116c}.badge{display:inline-block;padding:5px 12px;background:#fff0ce;border-radius:20px}dialog{border:0;border-radius:15px;padding:0;width:min(760px,96vw);height:94vh;color:#220b4a;background:#fff4e8}dialog::backdrop{background:#220b4a99}form{height:100%;display:flex;flex-direction:column}.body{padding:20px;overflow:auto;flex:1;min-height:0}.footer{padding:12px;background:white;border-top:1px solid #dcd4e6;display:flex;gap:6px;flex-wrap:wrap}.footer button{flex:1}.check{display:flex;align-items:center;gap:10px}.check input{width:24px;margin:0}.error{color:#a72e28}[hidden]{display:none!important}</style><link rel="stylesheet" href="/warehouse-ui.css"></head><body><a href="/warehouse">← Management</a><h1>Store delivery instructions</h1><p>Review driver suggestions before updating a customer or location. Approved updates reach drivers when their app reconnects.</p><button id="refresh">Refresh</button><p id="message" role="status"></p><h2>Driver update approvals</h2><div id="queue"></div><h2>Approved store guides</h2><input id="search" aria-label="Find store guide" placeholder="Find a customer or location"><div id="guides"></div>
<dialog id="review"><form id="review-form"><div class="body"><h2 id="review-title"></h2><p id="origin"></p><label for="customer">Apply to customer / delivery location</label><select id="customer" required></select><label for="mode">How to apply</label><select id="mode"><option value="append">Append to current instructions</option><option value="replace">Replace current instructions</option></select><details><summary>Current approved instructions</summary><pre id="current"></pre></details><label for="instructions">Reviewed instruction text</label><textarea id="instructions" required minlength="5" maxlength="6000"></textarea><div id="media"></div><label for="reason">Review note / reason</label><textarea id="reason" required minlength="5" maxlength="1000" placeholder="Explain your approval or rejection"></textarea><p id="error" class="error" role="alert"></p></div><div class="footer"><button class="primary" id="approve" type="submit">Approve update</button><button type="button" class="danger" id="reject">Reject</button><button type="button" id="close">Cancel</button></div></form></dialog>
<script>
const $=id=>document.getElementById(id);let session,updates=[],guides=[],customers=[],selected,busy=false;function el(tag,text){const n=document.createElement(tag);if(text!==undefined)n.textContent=text;return n;}async function api(path,body){const r=await fetch('/api/warehouse'+path,{credentials:'same-origin',headers:body?{'Content-Type':'application/json','X-Warehouse-CSRF':session.csrf}:{},...(body?{method:'POST',body:JSON.stringify(body)}:{})});const d=await r.json();if(!r.ok)throw Error(d.error||'Request failed');return d;}
function media(parent,m,url){const details=el('details');details.append(el('summary',m.title|| (m.mimeType==='video/mp4'?'Video':'Photo')));if(m.mimeType==='image/jpeg'){const image=el('img');image.src=url;image.loading='lazy';image.alt=m.title||'Instruction suggestion photo';details.append(image);}else{const video=el('video');video.controls=true;video.preload='none';video.src=url;details.append(video);}parent.append(details);}
function draw(){const q=$('search').value.toLowerCase();$('queue').replaceChildren();const pending=updates.filter(u=>u.status==='pending');if(!pending.length)$('queue').append(el('p','No driver updates awaiting approval.'));for(const u of pending){const card=el('section');card.className='card';card.append(el('h3',u.customer_name),el('small',u.recorded_at+' · '+u.manifest.length+' attachments'),el('pre',u.notes));const b=el('button','Review suggestion');b.onclick=()=>open(u);card.append(b);$('queue').append(card);} $('guides').replaceChildren();for(const g of guides){if(q&&!g.title.toLowerCase().includes(q))continue;const card=el('details');card.className='card';card.append(el('summary',g.title),el('small','Updated '+g.updated_at),el('pre',g.instructions));for(const m of g.media)media(card,m,'/api/warehouse/reference-media/'+m.id);$('guides').append(card);}}
function targetGuide(){const target=customers[Number($('customer').value)];return target?guides.find(g=>g.customer_id===target.customerId&&(g.location_ref||'')===(target.referenceId||'')):null;}
function current(){const g=targetGuide();$('current').textContent=g?.instructions||'No approved guide yet. This approval creates one.';}
function open(u){selected=u;$('review-title').textContent='Review instruction update';$('origin').textContent='Suggested for '+u.customer_name+' · '+u.recorded_at;$('customer').replaceChildren(new Option('Choose the correct customer and location',''));customers.forEach((c,i)=>$('customer').add(new Option(c.name+(c.address?' · '+c.address:''),String(i))));let index=customers.findIndex(c=>c.customerId===u.customer_id&&(c.referenceId||'')===(u.reference_id||''));$('customer').value=index<0?'':String(index);$('mode').value='append';$('instructions').value=u.notes;$('reason').value='';$('error').textContent='';$('media').replaceChildren();for(const m of u.manifest){const label=el('label');label.className='check';const input=el('input');input.type='checkbox';input.value=m.id;input.checked=true;label.append(input,el('span','Include '+(m.mimeType==='video/mp4'?'video':'photo')+' in approved guide'));$('media').append(label);media($('media'),m,'/api/warehouse/instruction-updates/'+u.id+'/media/'+m.id);}current();$('review').showModal();}
async function review(action){if(busy)return;const reason=$('reason').value.trim();if(reason.length<5){$('error').textContent='Explain your review decision.';return;}const target=customers[Number($('customer').value)];if(action==='approve'&&($('customer').value===''||!target)){$('error').textContent='Choose the correct customer and delivery location.';return;}busy=true;$('approve').disabled=$('reject').disabled=true;try{const body={action,reason,...(action==='approve'?{customerId:target.customerId,referenceId:target.referenceId||'',instructions:$('instructions').value,mode:$('mode').value,expectedUpdatedAt:targetGuide()?.updated_at||'',mediaIds:[...$('media').querySelectorAll('input:checked')].map(n=>n.value)}:{})};await api('/instruction-updates/'+selected.id+'/review',body);$('review').close();$('message').textContent=action==='approve'?'Customer instructions updated. The decision is recorded.':'Suggestion rejected; customer instructions unchanged.';await load(false);}catch(e){$('error').textContent=e.message;}finally{busy=false;$('approve').disabled=$('reject').disabled=false;}}
async function load(notify=true){try{if(!session)session=await api('/session');const r=await Promise.all([api('/reference-guides'),api('/instruction-updates'),api('/instruction-customers')]);guides=r[0].guides;updates=r[1].updates;customers=r[2].customers;draw();if(notify)$('message').textContent='Updated '+new Date().toLocaleTimeString();}catch(e){$('message').textContent=e.message;}}
$('customer').onchange=current;$('search').oninput=draw;$('review-form').onsubmit=e=>{e.preventDefault();review('approve');};$('reject').onclick=()=>review('reject');$('close').onclick=()=>$('review').close();$('refresh').onclick=()=>load();setInterval(()=>{if(!$('review').open&&![...document.querySelectorAll('video')].some(v=>!v.paused))load(false);},30000);load();
</script></body></html>
