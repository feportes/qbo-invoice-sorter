<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Superfruits · Team & deliveries</title>
<style>
:root{font-family:system-ui,sans-serif;color:#19392e;background:#f3f6f3}*{box-sizing:border-box}body{margin:0}header{padding:22px 5%;background:white;border-bottom:1px solid #d7e3da;display:flex;justify-content:space-between;align-items:center;gap:16px}main{max-width:1120px;margin:28px auto;padding:0 18px}h1{font-size:28px}h2{font-size:21px}p{line-height:1.5}.card{background:white;border:1px solid #d7e3da;border-radius:16px;padding:24px;margin-bottom:20px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:18px}label{display:block;margin:14px 0 6px;font-weight:600}input,select,button{font:inherit;padding:12px;border:1px solid #b9cbbf;border-radius:8px;max-width:100%}input:not([type=checkbox]),select{width:100%}button{background:#226145;color:white;cursor:pointer;margin:6px 6px 6px 0}button.secondary{background:white;color:#22593e}button:disabled{opacity:.6;cursor:wait}input[type=checkbox]{margin-right:10px}small,.muted{color:#5a7165}.error{background:#ffe7df;color:#86391d}.notice{padding:14px;border-radius:9px;margin:14px 0;background:#e2efdc}.notice.error{background:#ffe7df}#message:empty{display:none}[hidden]{display:none!important}progress{width:100%;accent-color:#226145;height:18px}.row{display:flex;justify-content:space-between;gap:16px;align-items:center;flex-wrap:wrap}.badge{background:#e7eee8;padding:5px 10px;border-radius:20px}dialog{border:1px solid #b9cbbf;border-radius:16px;width:min(620px,94vw);max-height:92vh;padding:24px}dialog::backdrop{background:#10251d99}.photo{width:160px;height:120px;object-fit:cover;border-radius:8px;margin:8px}summary{cursor:pointer;padding:10px 0}.checks{display:grid;grid-template-columns:1fr 1fr}.checks label{font-weight:400;margin:8px 0}.actions{margin-top:18px}.thin{border-top:1px solid #e4ebe5;padding:12px 0}a{color:#226145}

/* D RAW website palette; operational status colors remain explicit. */
:root{--draw-cream:#fff4e8;--draw-deep:#220b4a;--draw-green:#91d729;--draw-pink:#ed168b;--draw-purple:#35116c;--draw-line:#dcd4e6;background:var(--draw-cream);color:var(--draw-deep)}
body{background:var(--draw-cream);color:var(--draw-deep)}body>header{background:var(--draw-purple);color:white;border-color:var(--draw-line)}body>header h1,body>header p,body>header strong{color:inherit}a{color:var(--draw-purple)}button.primary,button.active{background:var(--draw-purple);border-color:var(--draw-purple);color:white}.sf-main-nav{border-color:var(--draw-line)}.sf-main-nav>a,.sf-main-nav summary,.sf-main-nav details a{color:var(--draw-purple)}.sf-main-nav [aria-current=page],.sf-main-nav .current{background:var(--draw-green);color:var(--draw-deep)}.sf-main-nav a:hover,.sf-main-nav summary:hover{background:#f6d5eb}.warehouse-day-controls{background:#efe2f7;border-color:var(--draw-line)}input:focus-visible,select:focus-visible,button:focus-visible,a:focus-visible,textarea:focus-visible{outline:3px solid var(--draw-pink);outline-offset:2px}
button{background:#35116c;color:white}button.secondary{color:#35116c;background:#eadcf5}h1,h2{color:#220b4a}header strong{color:white}
</style><link rel="stylesheet" href="/warehouse-ui.css"></head><body>
<header><strong>SUPERFRUITS</strong><span id="identity">Team & deliveries</span><button id="logout" class="secondary" hidden>Sign out</button></header>
<main><h1>Team & deliveries</h1><nav aria-label="Management navigation"><a href="/warehouse-approvals">Pending Approvals</a> · <a href="/workspaces">← Workspaces</a> · <a href="#usersPanel" id="usersNav" hidden>Users & access</a></nav><p><a href="/warehouse-instructions">Customer delivery instructions & driver updates →</a> · <a href="/warehouse-security">Security / auto sign-out</a></p><div id="message" role="status" aria-live="polite"></div>
<section id="signin" class="card"><h2>Sign in</h2><form id="login"><label for="username">Username</label><input id="username" autocomplete="username" required><label for="password">Password</label><input id="password" type="password" autocomplete="current-password" required><button>Sign in</button></form>
<details><summary>Set up the first administrator</summary><p>Use the setup key supplied by the office. This works only before the first account exists.</p><form id="setup"><label>Name<input name="displayName" autocomplete="name" required></label><label>Username<input name="username" autocomplete="username" required></label><label>Password<input name="password" type="password" autocomplete="new-password" minlength="8" required></label><label>Setup key<input name="token" type="password" autocomplete="off" required></label><button>Create main administrator</button></form></details></section>
<section id="account" class="card" hidden><div class="row"><h2>Your account</h2><span id="role" class="badge"></span></div><p id="passwordHelp"></p><details id="passwordDetails"><summary>Change your password</summary><form id="passwordForm"><label>Current password<input name="currentPassword" type="password" autocomplete="current-password" required></label><label>New password<input name="newPassword" type="password" autocomplete="new-password" minlength="8" required></label><button>Save password</button></form></details></section>
<section id="usersPanel" class="card" hidden><div class="row"><h2>Users & access</h2><button id="newUser">Add user</button></div><p>You control credentials, roles and work functions. Managers can run operations; user and security changes require an administrator.</p><div id="users"></div></section>
<section id="routesPanel" hidden><div class="row"><h2>Route progress</h2><div><input id="routeDate" type="date" aria-label="Route date" style="width:auto"><button id="refresh" class="secondary">Refresh</button></div></div><p class="muted">Driver updates appear after the handheld syncs. Offline work remains on the device until it reconnects.</p><section id="warehouseObservations" class="card" hidden><h2>Warehouse shortage observations</h2><p>Quantity corrections made before departure. No office approval required.</p><div id="warehouseObservationList"></div></section><div id="routes" class="grid"></div></section>

<section id="auditPanel" class="card" hidden><details><summary>Recent activity</summary><button id="loadAudit" class="secondary">Refresh activity</button><div id="audit"></div></details></section>
</main>
<dialog id="editor"><h2 id="editorTitle">Add user</h2><form id="userForm"><label>Person’s name<input name="displayName" required maxlength="100"></label><label>Username<input name="username" autocomplete="off" required pattern="[a-z0-9][a-z0-9_.@+\-]{2,99}"></label><label>Role<select name="role"><option value="driver">Driver</option><option value="warehouse">Warehouse</option><option value="office">Office</option><option value="manager">Manager · operations</option><option value="admin">Administrator · full access</option></select></label><label>Route assignment<select name="teamId"><option value="">Choose the person on the route roster</option></select></label><small>Links this login to the person assigned in Planning. Required for drivers.</small><fieldset><legend>Work functions</legend><div id="functions" class="checks"></div></fieldset><label id="credentialLabel">Temporary password<input name="newPassword" type="password" autocomplete="new-password" minlength="8"></label><button type="button" id="generatePassword" class="secondary">Generate 8-digit temporary password</button><small>Use at least 8 characters. Temporary passwords must be changed at first sign-in. Leave blank when editing to keep the current password.</small><label><input name="enabled" type="checkbox" checked>Account enabled</label><div class="actions"><button>Save account</button><button type="button" id="cancel" class="secondary">Cancel</button></div></form></dialog>
<dialog id="routeDetail"><div class="row"><h2 id="routeTitle">Route activity</h2><button id="closeRoute" class="secondary">Close</button></div><div id="routeBody"></div></dialog>
<script>
'use strict';
const $=id=>document.getElementById(id),api='/api/warehouse';let session=null,editing=null,users=[],routeRows=[],team=[];
const functions=['deliveries','warehouse','receiving','planning','reports','products','vendors'];
function node(tag,text,cls){const n=document.createElement(tag);if(text!==undefined)n.textContent=text;if(cls)n.className=cls;return n;}
function notice(text,error=false){$('message').className='notice'+(error?' error':'');$('message').textContent=text;}
async function request(path,body){const r=await fetch(api+path,{method:body===undefined?'GET':'POST',credentials:'same-origin',headers:body===undefined?{}:{'Content-Type':'application/json','x-warehouse-csrf':session?.csrf||''},body:body===undefined?undefined:JSON.stringify(body)});const data=await r.json();if(!r.ok)throw Error(data.error||'This action could not be completed.');return data;}
function operation(form,fn){form.addEventListener('submit',async e=>{e.preventDefault();const buttons=[...form.querySelectorAll('button')];buttons.forEach(b=>b.disabled=true);try{await fn(new FormData(form));}catch(err){notice(err.message,true);}finally{buttons.forEach(b=>b.disabled=false);}});}
function visible(){const u=session?.user,ready=u&&!u.mustChangePassword;$('signin').hidden=!!u;$('account').hidden=!u;$('logout').hidden=!u;$('identity').textContent=u?u.displayName+' · '+u.username:'Team & deliveries';$('role').textContent=u?.role||'';$('passwordHelp').textContent=u?.mustChangePassword?'Change your temporary password before starting work.':'Your work is linked to your own account.';$('passwordDetails').open=!!u?.mustChangePassword;$('routesPanel').hidden=!ready||!(u.role==='admin'||u.functions.includes('deliveries'));$('usersPanel').hidden=!ready||u.role!=='admin';$('usersNav').hidden=$('usersPanel').hidden;$('auditPanel').hidden=!ready||!['admin','manager','office'].includes(u.role)||!(u.role==='admin'||u.functions.includes('reports'));}
async function load(){session=await request('/session');visible();if(!session.user.mustChangePassword){if(!$('routesPanel').hidden)await loadRoutes();if(session.user.role==='admin')await loadUsers();}}
operation($('login'),async()=>{await request('/login',{username:$('username').value,password:$('password').value,deviceLabel:'Office browser'});$('password').value='';await load();notice('Signed in.');});
operation($('setup'),async data=>{await request('/bootstrap',Object.fromEntries(data));$('setup').reset();notice('Main administrator created. Sign in with your new username and password.');});
operation($('passwordForm'),async data=>{const result=await request('/password',Object.fromEntries(data));session.user=result.user;$('passwordForm').reset();await load();notice('Password updated.');});
$('logout').onclick=async()=>{try{await request('/logout',{});session=null;$('users').replaceChildren();$('routes').replaceChildren();visible();notice('Signed out.');}catch(e){notice(e.message,true);}};
async function loadUsers(){users=(await request('/users')).users;try{team=(await request('/team-identities')).team;}catch{team=[];}const box=$('users');box.replaceChildren();for(const u of users){const row=node('div',undefined,'row thin'),info=node('div');info.append(node('strong',u.displayName),node('p',u.username+' · '+u.role+' · '+(u.enabled?'Enabled':'Disabled')+(u.mustChangePassword?' · Password change required':'')));const edit=node('button','Edit access','secondary');edit.onclick=()=>openUser(u);row.append(info,edit);box.append(row);}}
function defaults(role){return ['admin','manager','office'].includes(role)?functions:role==='warehouse'?['warehouse','receiving','products']:['deliveries'];}
function functionChecks(selected,all){$('functions').replaceChildren();for(const name of functions){const label=node('label'),input=node('input');input.type='checkbox';input.name='functions';input.value=name;input.checked=all||selected.includes(name);input.disabled=all;label.append(input,document.createTextNode(name[0].toUpperCase()+name.slice(1)));$('functions').append(label);}}
function openUser(u){editing=u?.id||null;const f=$('userForm');f.reset();setPasswordVisible(f.elements.newPassword,false);f.elements.displayName.value=u?.displayName||'';f.elements.username.value=u?.username||'';f.elements.role.value=u?.role||'driver';f.elements.teamId.replaceChildren();const empty=node('option','Choose the person on the route roster');empty.value='';f.elements.teamId.append(empty);for(const person of team){const option=node('option',person.name);option.value=person.id;f.elements.teamId.append(option);}if(u?.teamId&&!team.some(p=>p.id===u.teamId)){const option=node('option','Current route assignment');option.value=u.teamId;f.elements.teamId.append(option);}f.elements.teamId.value=u?.teamId||'';f.elements.enabled.checked=u?.enabled??true;f.elements.newPassword.required=!u;functionChecks(u?.functions||defaults('driver'),u?.role==='admin');$('editorTitle').textContent=u?'Edit '+u.displayName:'Add user';$('editor').showModal();}
const passwordToggles=new Map();
function setPasswordVisible(field,show){const start=field.selectionStart,end=field.selectionEnd;field.type=show?'text':'password';const button=passwordToggles.get(field);if(button){button.textContent=show?'Hide password':'Show password';button.setAttribute('aria-pressed',String(show));}if(start!==null)field.setSelectionRange(start,end);}
for(const field of document.querySelectorAll('input[type=password]:not([name=token])')){const toggle=node('button','Show password','secondary');toggle.type='button';toggle.setAttribute('aria-pressed','false');toggle.onclick=()=>setPasswordVisible(field,field.type==='password');field.after(toggle);passwordToggles.set(field,toggle);}
$('generatePassword').onclick=()=>{const field=$('userForm').elements.newPassword;const random=new Uint32Array(1);do{crypto.getRandomValues(random);}while(random[0]>=4230000000);field.value=String(10000000+random[0]%90000000);setPasswordVisible(field,true);};
$('newUser').onclick=()=>openUser();$('cancel').onclick=()=>$('editor').close();
$('userForm').elements.role.onchange=e=>{functionChecks(defaults(e.target.value),e.target.value==='admin');};
$('userForm').elements.displayName.oninput=e=>{if(editing)return;const f=$('userForm');f.elements.username.value=e.target.value.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim().replace(/[^a-z0-9]+/g,'.').replace(/^\.|\.$/g,'')+'.'+f.elements.role.value;};
operation($('userForm'),async data=>{const body=Object.fromEntries(data);body.functions=$('userForm').elements.role.value==='admin'?functions:data.getAll('functions');body.enabled=data.has('enabled');if(!body.newPassword)delete body.newPassword;if(!editing){body.password=body.newPassword;delete body.newPassword;}const result=await request(editing?'/users/'+encodeURIComponent(editing):'/users',body);$('editor').close();$('userForm').reset();if(result.signInAgain){session=null;visible();notice('Your account was updated. Sign in again.');return;}await loadUsers();notice('Account saved. Access changes end that user’s existing sessions.');});
const localDate=new Date();$('routeDate').value=[localDate.getFullYear(),String(localDate.getMonth()+1).padStart(2,'0'),String(localDate.getDate()).padStart(2,'0')].join('-');
async function loadRoutes(){await loadWarehouseObservations();routeRows=(await request('/routes?includeCompleted=true&date='+encodeURIComponent($('routeDate').value))).routes;const box=$('routes');box.replaceChildren();if(!routeRows.length)box.append(node('p','No assigned routes for this date.'));for(const r of routeRows){const s=r.snapshot,done=s.stops.filter(x=>['completed','skipped'].includes(x.status)).length,card=node('article',undefined,'card');card.append(node('h2',s.name||r.id),node('p',r.route_date+' · '+r.status+' · '+(s.driverName||s.driverId)),node('p',done+' of '+s.stops.length+' stops completed'));const p=node('progress');p.max=Math.max(1,s.stops.length);p.value=done;p.setAttribute('aria-label','Stops completed');card.append(p,node('p','Last update: '+new Date(r.updated_at).toLocaleString(),'muted'));const b=node('button','View stops & activity','secondary');b.onclick=()=>showRoute(r.id);card.append(b);box.append(card);}}
async function loadWarehouseObservations(){if(!['admin','manager','office'].includes(session?.user.role))return;try{const result=await request('/warehouse-observations');$('warehouseObservations').hidden=!result.observations.length;const list=$('warehouseObservationList');list.replaceChildren();for(const row of result.observations){const p=row.payload,card=node('div',undefined,'thin');card.append(node('strong',p.customer+' - Invoice '+p.sourceInvoice),node('small',p.routeName+' - '+row.status+' - recorded by '+row.recorded_by));for(const line of p.lines.filter(l=>l.shortage))card.append(node('p',line.name+': '+line.requestedQty+' ordered, '+line.qty+' supplied - '+line.shortage.reason));if(p.customerNote)card.append(node('p','Customer note appended: '+p.customerNote));list.append(card);}}catch(e){notice(e.message,true);}}
$('refresh').onclick=() =>loadRoutes().catch(e=>notice(e.message,true));$('routeDate').onchange=$('refresh').onclick;
async function showRoute(id){try{const result=await request('/routes/'+encodeURIComponent(id)+'/activity'),r=result.route;$('routeTitle').textContent=r.snapshot.name||id;$('routeBody').replaceChildren();if(result.motive){const m=result.motive;routeBody.append(node('h2','Motive driving evidence'),node('p',m.status+' · '+(m.distanceMiles===null?'Mileage unavailable until vehicle and departure are recorded':m.distanceMiles.toFixed(1)+' miles from matched driving records')));for(const segment of m.records||[])routeBody.append(node('p',new Date(segment.startAt).toLocaleString()+' · '+segment.distanceMiles.toFixed(1)+' miles · '+segment.origin+' → '+segment.destination));}const download=node('button','Download route activity CSV','secondary');download.onclick=()=>{const safe=value=>{const text=String(value??'');return '"'+(/^[=+@\-\t\r]/.test(text)?"'":'')+text.replaceAll('"','""')+'"';};const rows=[['Source','Time','Person / vehicle','Action','Details'],...(result.events||[]).map(e=>['Delivery app',e.recordedAt,e.displayName,e.kind,JSON.stringify(e.payload)]),...(result.motive?.records||[]).map(e=>['Motive',e.startAt,e.vehicleName,'Driving record',e.distanceMiles.toFixed(1)+' miles; '+e.origin+' → '+e.destination])];const blob=new Blob(['\ufeff'+rows.map(row=>row.map(safe).join(',')).join('\r\n')],{type:'text/csv;charset=utf-8'}),url=URL.createObjectURL(blob),a=node('a');a.href=url;a.download='route-activity-'+r.id+'.csv';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);};routeBody.append(download);for(const s of r.snapshot.stops){const item=node('div',undefined,'thin');item.append(node('strong',s.customerName||s.id),node('p',(s.status||'pending')+(s.officeReview?' · Office review: '+s.officeReview:'')));for(const p of s.products)item.append(node('p',p.name+' · '+(s.counts?.[p.id]||0)+' / '+Math.ceil(p.qty)));$('routeBody').append(item);}for(const issue of result.syncIssues||[]){const warning=node('p','Office handoff: '+issue.error,'notice error');routeBody.append(warning);}for(const e of result.events){const item=node('div',undefined,'thin');item.append(node('strong',e.kind+' · '+e.displayName),node('p',new Date(e.recordedAt).toLocaleString()+' · '+e.status,'muted'));const text=e.payload.reason||e.payload.notes;if(text)item.append(node('p',text));for(const id of e.payload.mediaIds||[]){const a=node('a');a.href=api+'/media/'+encodeURIComponent(id);a.target='_blank';a.rel='noopener';const img=node('img');img.src=a.href;img.alt='Delivery photo';img.className='photo';img.loading='lazy';a.append(img);item.append(a);}$('routeBody').append(item);}$('routeDetail').showModal();}catch(e){notice(e.message,true);}}
$('closeRoute').onclick=()=>$('routeDetail').close();$('loadAudit').onclick=async()=>{try{const result=await request('/audit');$('audit').replaceChildren(...result.records.map(r=>node('p',new Date(r.at).toLocaleString()+' · '+r.action+' · '+r.entity_type)));}catch(e){notice(e.message,true);}};
setInterval(()=>{if(session&&!session.user.mustChangePassword&&!$('routesPanel').hidden&&!document.hidden)loadRoutes().catch(()=>{});},30000);
load().catch(e=>{visible();if(!/Sign in/.test(e.message))notice(e.message,true);});
</script><script type="module">import {officeNotifications} from "/workspaces-assets/office-notification.js";fetch("/api/warehouse/session",{credentials:"same-origin",cache:"no-store"}).then(r=>r.ok?r.json():null).then(officeNotifications);</script></body></html>
