<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Products & barcodes · D’ RAW</title><link rel="stylesheet" href="/warehouse-ui.css"></head><body><main><h1>Products & barcodes</h1><p>Scan a product or find it by name, SKU or UPC. Each SKU identifies its own product.</p><div class="toolbar"><input id="search" placeholder="Scan or search products" aria-label="Search products"><button id="refresh">Refresh list</button><button id="keyboard">Hide keyboard</button></div><p id="message" role="status"></p><div id="products"></div><dialog id="editor"><form id="details"><h2 id="title"></h2><label>Product name<input name="name" required></label><label>SKU<input name="sku"></label><label>Weight / size<input name="weight"></label><label>Description<textarea name="description"></textarea></label><button class="primary">Save product information</button><h3>Barcode aliases</h3><div id="barcodes"></div><label>New barcode<input id="code" autocomplete="off"></label><button type="button" id="add">Add barcode</button><div class="actions"><button type="button" id="close">Close</button><button type="button" id="hide">Hide keyboard</button></div></form></dialog></main><script>
const $=id=>document.getElementById(id),norm=v=>String(v||'').trim().toUpperCase();let session,data,product,busy=false,pending;async function api(path,body){const r=await fetch('/api/warehouse'+path,{credentials:'same-origin',cache:'no-store',...(body?{method:'POST',headers:{'Content-Type':'application/json','X-Warehouse-CSRF':session.csrf},body:JSON.stringify(body)}:{})});const result=await r.json();if(!r.ok)throw Error(result.error||'Products unavailable.');return result;}function node(tag,text){const n=document.createElement(tag);n.textContent=text;return n;}async function load(){session=await api('/session');data=await api('/products');draw();}function draw(){const q=norm($('search').value),box=$('products');box.replaceChildren();const groups=new Map();for(const p of data.products.filter(p=>[p.name,p.sku,...p.barcodes.map(b=>b.code)].some(v=>norm(v).includes(q)))){const group=groups.get(p.category)||[];group.push(p);groups.set(p.category,group);}for(const [category,items] of groups){const detail=node('details','');detail.open=!!q;detail.append(node('summary',category+' · '+items.length));for(const p of items){const button=node('button',p.name+' · '+(p.sku||'No SKU'));button.style='display:block;width:100%;text-align:left;margin:8px 0';button.onclick=()=>open(p);detail.append(button);}box.append(detail);}if(!groups.size)box.append(node('p','No matching product.'));}function open(p){product=p;$('title').textContent=p.name;for(const key of ['name','sku','weight','description'])$('details').elements[key].value=p[key]||'';$('barcodes').replaceChildren();for(const b of p.barcodes){const row=node('p',b.code+' '),remove=node('button','Remove');remove.type='button';remove.onclick=()=>{if(confirm('Remove barcode '+b.code+' from this product?'))save('manageProductBarcode',[p.id,{action:'remove',barcode:b.code}]);};row.append(remove);$('barcodes').append(row);}$('code').value=window.unrecognizedBarcode||'';if(!$('editor').open)$('editor').showModal();}async function save(name,args){if(busy)return;busy=true;const key='draw-product-save:'+session.user.id;try{if(!pending)pending={requestId:crypto.randomUUID(),baseRevision:data.revision,command:{name,args}};localStorage.setItem(key,JSON.stringify(pending));data=await api('/products',pending);pending=null;localStorage.removeItem(key);$('message').textContent=data.message||'Product saved. Connected drivers receive new codes automatically.';const updated=data.products.find(p=>p.id===product.id);draw();if(updated)open(updated);}catch(e){$('message').textContent=e.message+' Your save identifier is retained. Use Retry save to confirm before making another change.';if(!$('retry')){const b=node('button','Retry save');b.id='retry';b.onclick=()=>save();$('message').after(b);}}finally{busy=false;if(!pending)$('retry')?.remove();}}$('details').onsubmit=e=>{e.preventDefault();const d=Object.fromEntries(new FormData($('details')));save('saveWarehouseProduct',[product.id,d]);};$('add').onclick=()=>{if($('code').value.trim())save('manageProductBarcode',[product.id,{action:'add',barcode:$('code').value.trim()}]);};function scan(code){const q=norm(code),matches=data.products.filter(p=>norm(p.sku)===q||p.barcodes.some(b=>norm(b.code)===q));if(matches.length===1)open(matches[0]);else{$('search').value=code;draw();$('message').textContent=matches.length?'This code matches multiple products. Choose the correct product.':'Barcode not recognized. Search for the product, open it, then add this code.';if(!matches.length)window.unrecognizedBarcode=String(code);}}window.addEventListener('zebra-scan',e=>scan(e.detail?.barcode||e.detail));$('search').oninput=draw;$('search').onkeydown=e=>{if(e.key==='Enter'){e.preventDefault();scan(e.target.value);e.target.blur();}};$('refresh').onclick=()=>load().catch(e=>$('message').textContent=e.message);$('close').onclick=()=>$('editor').close();$('hide').onclick=$('keyboard').onclick=()=>document.activeElement?.blur();load().then(()=>{const raw=localStorage.getItem('draw-product-save:'+session.user.id);if(raw){pending=JSON.parse(raw);$('message').textContent='A previous product save needs confirmation. Refresh and review before editing.';const b=node('button','Retry previous save');b.onclick=()=>{product=data.products.find(p=>p.id===pending.command.args[0]);save();};$('message').after(b);}}).catch(e=>$('message').textContent=e.message);
</script><script type="module" src="/workspaces-assets/product-request-review.js"></script></body></html>
