<!doctype html>
<html>
<head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Add Pallet</title>
  <style>
    * { box-sizing: border-box; }
    body { font-family: system-ui; margin: 24px; max-width: 1000px; }
    .muted { color:#666; font-size:13px; }
    a { color:#111; text-decoration:none; }
    .card { border:1px solid #ddd; border-radius:12px; padding:16px; background:#fff; margin-top:14px; }
    .row { display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end; }
    label { display:block; font-size:13px; color:#666; margin-bottom:6px; }
    select, input { padding:10px; border:1px solid #ddd; border-radius:10px; }
    input[type="number"] { width: 140px; }
    .btn { padding:10px 14px; border-radius:10px; border:1px solid #333; background:#111; color:#fff; }
    .msg { margin-top:12px; padding:10px; border-radius:10px; background:#f4f4f4; }

    .grid { display:grid; grid-template-columns: 1fr 1fr; gap:16px; margin-top:14px; }
    .col { border:1px solid #eee; border-radius:12px; padding:12px; }
    .slot {
      border:1px solid #e6e6e6;
      border-radius:12px;
      padding:10px;
      margin-bottom:10px;
      cursor:pointer;
      user-select:none;
    }
    .slot:hover { outline:2px dashed #111; }
    .slot.selected { outline:2px solid #0a7; background:#f2fffb; }
    .code { font-weight:700; }
    .topbar { display:flex; gap:10px; flex-wrap:wrap; align-items:center; }
      .slot.occupied { background:#f0fdf4; border:1px solid #86efac; }
    .pallet-info { font-size:0.78em; color:#333; margin-top:4px; }
</style>
</head>
<body>

<h1 style="margin:0;">Add Pallet</h1>
<div class="muted">
  Fast receive: pick SKU, qty, and click a slot.
</div>

<div class="muted" style="margin-top:10px;">
  <a href="/inventory/map?c=<%= containerNo %>">Container Map</a> |
  <a href="/inventory/settings/pallet-configs">Pallet Configs</a> |
  <a href="/inventory/settings/skus">SKU Settings</a> |
  <a href="/">Home</a>
</div>

<% if (msg) { %><div class="msg"><%= msg %></div><% } %>

<% if(loadingNote) { %><p><strong>Loading note:</strong> <%= loadingNote %>. Match the product and its units; check existing stock before receiving a new pallet.</p><% } %>
<div class="card">
  <form method="get" action="/inventory/add-pallet" class="topbar">
    <label style="margin:0;">
      <span class="muted"><b>Container</b></span><br/>
      <select name="c" onchange="this.form.submit()">
        <% containers.forEach(c => { %>
          <option value="<%= c %>" <%= (c === containerNo) ? 'selected' : '' %>>C<%= c %></option>
        <% }) %>
      </select>
    </label>
  </form>

  <form method="post" action="/inventory/add-pallet" id="addForm">
    <input type="hidden" name="containerNo" value="<%= containerNo %>"/>
    <input type="hidden" name="location_code" id="location_code" value="<%= selectedSlot %>"/>

    <div class="row" style="margin-top:12px;">
      <div style="min-width:240px; flex:1;">
        <label for="productSearch">Find frozen products, gelato, yogurt or sorbet</label>
        <input id="productSearch" type="search" placeholder="Search product name" value="<%= productSearch %>" style="width:100%;margin-bottom:8px">
        <label for="productCategory">Product category</label>
        <select id="productCategory" style="width:100%;margin-bottom:8px"><option value="">All active products</option><option value="frozen">Frozen / gelato / yogurt / sorbet</option><% categories.forEach(cat=>{ %><option value="<%= cat.id %>"><%= cat.name %></option><% }); %></select>
        <label>SKU (active only; uses the synced catalog)</label>
        <select name="sku_id" required style="width:100%;">
          <option value="">-- select SKU --</option>
          <% (skus || []).forEach(s => { %>
            <option value="<%= s.id %>" data-category="<%= s.qbo_category_id || '' %>" data-category-name="<%= categories.find(c=>String(c.id)===String(s.qbo_category_id))?.name || '' %>"><%= s.name %> (<%= s.unit_type %>)</option>
          <% }) %>
        </select>
      </div>

      <div>
        <label>Qty</label>
        <input type="number" step="0.01" name="qty_units" min="0.01" required />
      </div>

      <div style="min-width:220px;">
        <label>Notes (optional)</label>
        <input type="text" name="notes" value="<%= loadingNote %>" placeholder="ex: received today" style="width:100%;" />
      </div>

      <div>
        <button class="btn" type="submit">Add Pallet</button>
      </div>
    </div>

    <div class="muted" style="margin-top:10px;">
      Selected slot: <b id="slotLabel">none</b>
    </div>

    <p class="muted" style="text-align:center">BACK / CLOSED END</p><div class="grid">
      <div class="col">
        <h3 style="margin:0 0 10px 0;">LEFT (L) <span class="muted">01 = closest to door; back at top</span></h3>
        <% [...left].reverse().forEach(s => { %>
          <div class="slot<%= s.pallet ? ' occupied' : '' %>" data-slot="<%= s.code %>">
            <div class="code"><%= s.code %></div>
            <% if (s.pallet) { %><div class="pallet-info"><strong><%= s.pallet.sku_name %></strong> &mdash; <%= s.pallet.qty_units %> <%= s.pallet.unit_type || 'units' %><% if (s.pallet.lot_number) { %> &bull; Lot <%= s.pallet.lot_number %><% } %></div><% } %>
          </div>
        <% }) %>
      </div>

      <div class="col">
        <h3 style="margin:0 0 10px 0;">RIGHT (R) <span class="muted">01 = closest to door; back at top</span></h3>
        <% [...right].reverse().forEach(s => { %>
          <div class="slot<%= s.pallet ? ' occupied' : '' %>" data-slot="<%= s.code %>">
            <div class="code"><%= s.code %></div>
            <% if (s.pallet) { %><div class="pallet-info"><strong><%= s.pallet.sku_name %></strong> &mdash; <%= s.pallet.qty_units %> <%= s.pallet.unit_type || 'units' %><% if (s.pallet.lot_number) { %> &bull; Lot <%= s.pallet.lot_number %><% } %></div><% } %>
          </div>
        <% }) %>
      </div>
    </div><p class="muted" style="text-align:center">DOOR / ENTRANCE</p>
  </form>
</div>

<script>
  const slots = document.querySelectorAll('.slot');
  const loc = document.getElementById('location_code');
  const label = document.getElementById('slotLabel');

  slots.forEach(el => {
    el.addEventListener('click', () => {
      if (el.classList.contains('occupied')) return;
      slots.forEach(x => x.classList.remove('selected'));
      el.classList.add('selected');
      const code = el.dataset.slot;
      loc.value = code;
      label.textContent = code;
    });
  });

  const initial = [...slots].find(s => s.dataset.slot === loc.value && !s.classList.contains('occupied'));
  if (initial) { initial.classList.add('selected'); label.textContent = loc.value; } else { loc.value = ''; }
  const skuSelect = document.querySelector('select[name="sku_id"]');
  const products = [...skuSelect.options].slice(1).map(o=>o.cloneNode(true));
  function filterProducts() {
    const q = document.getElementById('productSearch').value.toLowerCase();
    const cat = document.getElementById('productCategory').value;
    const selected = skuSelect.value;
    skuSelect.replaceChildren(new Option('-- select SKU --', ''));
    products.forEach(o=>{
      const categoryMatch = !cat || (cat === 'frozen' ? /frozen|gelato|yog[hu]rt|sorbet|acai|açaí|pitaya|puree|purée|iqf/i.test(o.textContent+' '+o.dataset.categoryName) : o.dataset.category===cat);
      if (categoryMatch && o.textContent.toLowerCase().includes(q)) skuSelect.append(o.cloneNode(true));
    });
    skuSelect.value = [...skuSelect.options].some(o=>o.value===selected) ? selected : '';
  }
  document.getElementById('productSearch').oninput = filterProducts;
  document.getElementById('productCategory').onchange = filterProducts;
  filterProducts();

  document.getElementById('addForm').addEventListener('submit', (e) => {
    if (!loc.value) {
      e.preventDefault();
      alert('Please click a slot first.');
    }
  });
</script>

</body>
</html>
